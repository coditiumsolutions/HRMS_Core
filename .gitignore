# .gitignore for ASP.NET Core (.NET 8) MVC + EF Core + SQL Server

# ---------------------------------------------------------------
# User-specific files
# ---------------------------------------------------------------
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# ---------------------------------------------------------------
# Build results
# ---------------------------------------------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
_build_verify/

# Publish / deploy output
publish/
**/publish/
PublishScripts/
*.pubxml.user
*.publishproj
# NOTE: shared publish profiles (Properties/PublishProfiles/*.pubxml) are kept in source control.

# ---------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------
.vs/
.idea/
*.sln.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.ionide/
.mfractor/
.localhistory/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.cr/
*.tss

# ---------------------------------------------------------------
# .NET / MSBuild / NuGet
# ---------------------------------------------------------------
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
MigrationBackup/
ScaffoldingReadMe.txt
FodyWeavers.xsd
*.binlog
*.rsp
*.pdb
*.ilk
*.obj
*.iobj
*.pch
*.ipdb
*.pgc
*.pgd
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*_i.c
*_p.c
*_h.h
*.meta
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

# ---------------------------------------------------------------
# Tests / coverage / profiling
# ---------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
[Cc]overage/
*.psess
*.vsp
*.vspx
*.sap
OpenCover/
healthchecksdb

# ---------------------------------------------------------------
# Local configuration & secrets (never commit)
# ---------------------------------------------------------------
# Real per-environment settings (contain connection strings). Commit only the *.example.json files.
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
*.pfx
*.snk
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Full DB export (schema + data; may contain passwords and PII - regenerate locally)
database-production.sql
*.bak
*.mdf
*.ldf
*.ndf

# ---------------------------------------------------------------
# User-uploaded files (keep folder via .gitkeep)
# ---------------------------------------------------------------
src/HRMBT.Web/wwwroot/uploads/*
!src/HRMBT.Web/wwwroot/uploads/employees/
src/HRMBT.Web/wwwroot/uploads/employees/*
!src/HRMBT.Web/wwwroot/uploads/employees/.gitkeep

# ---------------------------------------------------------------
# Front-end tooling (if introduced later)
# ---------------------------------------------------------------
node_modules/
npm-debug.log*

# ---------------------------------------------------------------
# OS files
# ---------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
__pycache__/
*.pyc
*.cab
*.msi
*.msix
*.msm
*.msp
