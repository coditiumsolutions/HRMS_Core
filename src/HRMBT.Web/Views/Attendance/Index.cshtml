@model IEnumerable<HRMBT.Web.Models.Attendance>

@{
    ViewData["Title"] = "Attendance Management";
    ViewData["Module"] = "Attendance";
    var editBaseUrl = Url.Action("Edit", "Attendance");
    var deleteBaseUrl = Url.Action("Delete", "Attendance");
    var detailsBaseUrl = Url.Action("Details", "Attendance");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <style>
        .attendance-header-actions .btn-attendance-action,
        .employee-list-page .btn-attendance-action {
            border-radius: 0.25rem !important;
            background: #fff3cd !important;
            color: #664d03 !important;
            border: 1px solid #e0c04a !important;
            font-weight: 600;
            font-size: 0.75rem !important;
            padding: 0.15rem 0.55rem !important;
            min-height: 1.45rem !important;
            height: 1.45rem;
            line-height: 1.2 !important;
            display: inline-flex;
            align-items: center;
        }
        .attendance-header-actions .btn-attendance-action:hover,
        .employee-list-page .btn-attendance-action:hover {
            background: #ffe69c !important;
            color: #533f03 !important;
            border-color: #d4af37 !important;
        }
        .attendance-header-actions .btn-attendance-create,
        .employee-list-page .btn-attendance-create {
            font-size: 0.7rem !important;
            padding: 0.12rem 0.45rem !important;
            min-height: 1.3rem !important;
            height: 1.3rem;
        }
        .attendance-header-actions .btn-attendance-create .bi,
        .employee-list-page .btn-attendance-create .bi {
            font-size: 0.7rem;
        }
    </style>
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-3 px-lg-4">

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Attendance records</span>
                <div class="d-flex flex-wrap align-items-center gap-2 attendance-header-actions">
                    @if (Model != null && Model.Any())
                    {
                        <div class="grid-selection-actions">
                            <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                            <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                        </div>
                    }
                    <a asp-action="Create" class="btn btn-sm btn-attendance-action btn-attendance-create"><i class="bi bi-plus me-1"></i>Create New</a>
                    <a asp-action="OffDay" class="btn btn-sm btn-attendance-action"><i class="bi bi-calendar-x me-1"></i>Off-Day</a>
                    <a asp-action="Upload" class="btn btn-sm btn-attendance-action"><i class="bi bi-upload me-1"></i>Upload CSV</a>
                    <a asp-action="MonthlyReport" class="btn btn-sm btn-attendance-action"><i class="bi bi-bar-chart me-1"></i>Monthly Report</a>
                </div>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="attendanceGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-details-base="@detailsBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>@Html.DisplayNameFor(model => model.AttendanceID)</th>
                                    <th>@Html.DisplayNameFor(model => model.EmployeeID)</th>
                                    <th>@Html.DisplayNameFor(model => model.EmployeeName)</th>
                                    <th>@Html.DisplayNameFor(model => model.DepartmentName)</th>
                                    <th>@Html.DisplayNameFor(model => model.AttendanceDate)</th>
                                    <th>@Html.DisplayNameFor(model => model.TimeIn)</th>
                                    <th>@Html.DisplayNameFor(model => model.TimeOut)</th>
                                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var statusClass = item.Status switch
                                    {
                                        "P" => "status-active",
                                        "A" => "status-inactive",
                                        "L" => "status-pending",
                                        "H" => "status-leave",
                                        _ => "status-default"
                                    };
                                    var statusLabel = item.Status switch
                                    {
                                        "P" => "Present",
                                        "A" => "Absent",
                                        "L" => "Late",
                                        "H" => "Holiday",
                                        _ => item.Status ?? "—"
                                    };
                                    <tr data-record-id="@item.AttendanceID" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedAttendance" value="@item.AttendanceID" aria-label="Select attendance @item.AttendanceID" />
                                        </td>
                                        <td>@item.AttendanceID</td>
                                        <td class="col-emp-id"><span class="text-muted small emp-id-cell">@item.EmployeeID</span></td>
                                        <td><div class="emp-name">@item.EmployeeName</div></td>
                                        <td>@item.DepartmentName</td>
                                        <td class="text-nowrap">@item.AttendanceDate.ToString("yyyy-MM-dd")</td>
                                        <td>@(item.TimeIn?.ToString(@"hh\:mm\:ss") ?? "—")</td>
                                        <td>@(item.TimeOut?.ToString(@"hh\:mm\:ss") ?? "—")</td>
                                        <td><span class="status-pill @statusClass">@statusLabel</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No attendance records found</h5>
                        <p class="mb-3">Create a new attendance record to get started.</p>
                        <a asp-action="Create" class="btn btn-sm btn-attendance-action btn-attendance-create"><i class="bi bi-plus me-1"></i>Create New</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
