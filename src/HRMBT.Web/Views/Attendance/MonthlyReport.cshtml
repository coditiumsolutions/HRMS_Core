@model List<HRMBT.Web.Models.ViewModels.EmployeeMonthlySummary>

@{
    ViewData["Title"] = "Monthly Attendance Report";
    ViewData["Module"] = "Attendance";
    var month = ViewBag.Month ?? DateTime.Now.Month;
    var year = ViewBag.Year ?? DateTime.Now.Year;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <div class="toolbar-card mb-4">
            <div class="toolbar-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="bi bi-bar-chart"></i>Monthly Attendance Report</span>
                <div class="toolbar-actions d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-action-secondary">Back to List</a>
                </div>
            </div>
        </div>

        <div class="filter-card mb-4">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Select month, year &amp; department</span>
            </div>
            <div class="card-body p-3 p-lg-4">
                <form asp-action="MonthlyReport" method="get" class="row g-3 align-items-end">
                    <div class="col-12 col-md">
                        <label for="month" class="form-label">Month</label>
                        <select name="month" id="month" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i);
                                if (i == month)
                                {
                                    <option value="@i" selected>@monthName</option>
                                }
                                else
                                {
                                    <option value="@i">@monthName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md">
                        <label for="year" class="form-label">Year</label>
                        <input type="number" name="year" id="year" class="form-control" value="@year" min="2000" max="2100" />
                    </div>
                    <div class="col-12 col-md">
                        <label for="department" class="form-label">Department</label>
                        <select name="department" id="department" class="form-select">
                            <option value="">All Departments</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    if (ViewBag.SelectedDepartment != null && ViewBag.SelectedDepartment.ToString() == dept)
                                    {
                                        <option value="@dept" selected>@dept</option>
                                    }
                                    else
                                    {
                                        <option value="@dept">@dept</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-action-primary w-100">
                            <i class="bi bi-funnel-fill me-1"></i>Apply
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header">
                <span><i class="bi bi-table"></i>Report for @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month) @year</span>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid">
                            <thead>
                                <tr>
                                    <th>Employee ID</th>
                                    <th>Employee Name</th>
                                    <th>Department</th>
                                    <th class="text-center">Total Present</th>
                                    <th class="text-center">Total Absent</th>
                                    <th class="text-center">Total Late</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.EmployeeID</td>
                                        <td>@item.EmployeeName</td>
                                        <td>@item.DepartmentName</td>
                                        <td class="text-center">
                                            <span class="status-pill status-active">@item.TotalPresent</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-pill status-inactive">@item.TotalAbsent</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-pill status-pending">@item.TotalLate</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"><strong>Total</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(e => e.TotalPresent)</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(e => e.TotalAbsent)</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(e => e.TotalLate)</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No attendance records found</h5>
                        <p class="mb-0">No records for @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month) @year.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
