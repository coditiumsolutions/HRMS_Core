@model List<HRMBT.Web.Models.ViewModels.DepartmentAttendanceSummary>

@{
    ViewData["Title"] = "Attendance By Department";
    ViewData["Module"] = "Attendance";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <div class="toolbar-card mb-4">
            <div class="toolbar-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="bi bi-building"></i>Attendance By Department</span>
                <div class="toolbar-actions d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-action-secondary">Back to List</a>
                </div>
            </div>
        </div>

        <div class="filter-card mb-4">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Select date</span>
            </div>
            <div class="card-body p-3 p-lg-4">
                <form asp-action="AttendanceByDepartment" method="get" class="row g-3 align-items-end">
                    <div class="col-12 col-md">
                        <label for="date" class="form-label">Attendance Date</label>
                        <input type="date" name="date" id="date" class="form-control"
                               value="@ViewBag.SelectedDate" required />
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-action-primary w-100">
                            <i class="bi bi-funnel-fill me-1"></i>Apply
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header">
                <span>
                    <i class="bi bi-table"></i>
                    @if (ViewBag.AttendanceDate != null)
                    {
                        <text>Department summary for @ViewBag.AttendanceDate.ToString("dd MMM yyyy")</text>
                    }
                    else
                    {
                        <text>Department-wise attendance summary</text>
                    }
                </span>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th class="text-center">Total Employees</th>
                                    <th class="text-center">Present</th>
                                    <th class="text-center">Absent</th>
                                    <th class="text-center">Late</th>
                                    <th class="text-center">Holiday</th>
                                    <th class="text-center">Not Marked</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model)
                                {
                                    <tr>
                                        <td><strong>@dept.DepartmentName</strong></td>
                                        <td class="text-center">@dept.TotalEmployees</td>
                                        <td class="text-center">
                                            <span class="status-pill status-active">@dept.Present</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-pill status-inactive">@dept.Absent</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-pill status-pending">@dept.Late</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-pill status-leave">@dept.Holiday</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-pill status-default">@dept.NotMarked</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td><strong>Total</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(d => d.TotalEmployees)</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(d => d.Present)</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(d => d.Absent)</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(d => d.Late)</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(d => d.Holiday)</strong></td>
                                    <td class="text-center"><strong>@Model.Sum(d => d.NotMarked)</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No department data found</h5>
                        <p class="mb-0">No department data found for the selected date.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
