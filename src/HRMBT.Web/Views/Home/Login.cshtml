@model HRMBT.Web.Models.ViewModels.LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

<form asp-action="Login" method="post">
    @{
        var returnUrl = ViewData["ReturnUrl"] as string;
    }
    @if (!string.IsNullOrEmpty(returnUrl))
    {
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div class="alert alert-info small mb-3 py-2" role="status">Sign in to continue (you will return to your requested page after a successful login).</div>
    }
    <div asp-validation-summary="All" class="alert alert-danger small mb-3 py-2" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" autocomplete="username" />
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="password-field">
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <button type="button" class="password-toggle" id="togglePassword" aria-label="Show password" aria-pressed="false" title="Show password">
                <svg class="icon-show" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
                <svg class="icon-hide" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" hidden><path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/><path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/></svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-0">
        <button type="submit" class="btn btn-primary">Sign in</button>
    </div>
</form>

@section Styles {
    <style>
        .password-field { position: relative; }
        .password-field .form-control { padding-right: 2.9rem; }
        .password-toggle {
            position: absolute; top: 0; right: 0; height: 100%; width: 2.9rem;
            display: inline-flex; align-items: center; justify-content: center;
            background: transparent; border: 0; color: #7a8396; border-radius: 0 7px 7px 0; cursor: pointer;
        }
        .password-toggle:hover { color: #0b1f3f; }
        .password-toggle[aria-pressed="true"] { color: #2d6a87; }
        .password-toggle svg[hidden] { display: none; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('Password');
            var btn = document.getElementById('togglePassword');
            if (!input || !btn) return;
            btn.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                btn.title = show ? 'Hide password' : 'Show password';
                // SVG elements have no .hidden property, so toggle the attribute itself
                btn.querySelector('.icon-show').toggleAttribute('hidden', show);
                btn.querySelector('.icon-hide').toggleAttribute('hidden', !show);
                input.focus();
            });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
