@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
<link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />

<div class="home-dashboard">
    <div class="page-header-card">
        <h1>HR Management Dashboard</h1>
        <p class="subtitle">Overview of people, attendance, leave, and payroll at a glance.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="stat-card accent-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-label">Total Employees</div>
                            <p class="stat-value">@ViewData["TotalEmployees"]</p>
                        </div>
                        <span class="stat-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
                    </div>
                    <a asp-controller="Employee" asp-action="Index" class="stat-link">
                        View all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="stat-card accent-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-label">Active Employees</div>
                            <p class="stat-value">@ViewData["ActiveEmployees"]</p>
                        </div>
                        <span class="stat-icon" aria-hidden="true"><i class="bi bi-person-check-fill"></i></span>
                    </div>
                    <a asp-controller="Employee" asp-action="Index" class="stat-link">
                        View active <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="stat-card accent-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-label">Today's Attendance</div>
                            <p class="stat-value">@ViewData["TodayAttendance"]</p>
                        </div>
                        <span class="stat-icon" aria-hidden="true"><i class="bi bi-calendar2-check-fill"></i></span>
                    </div>
                    <a asp-controller="Attendance" asp-action="Index" class="stat-link">
                        View attendance <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="stat-card accent-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-label">Pending Leave Requests</div>
                            <p class="stat-value">@ViewData["PendingLeaves"]</p>
                        </div>
                        <span class="stat-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                    </div>
                    <a asp-controller="LMS" asp-action="Index" class="stat-link">
                        View leaves <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="stat-card accent-secondary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-label">Total Payroll Records</div>
                            <p class="stat-value">@ViewData["TotalPayrolls"]</p>
                        </div>
                        <span class="stat-icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></span>
                    </div>
                    <a asp-controller="Payroll" asp-action="Index" class="stat-link">
                        View payroll <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="stat-card accent-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="stat-label">Tax Rules</div>
                            <p class="stat-value">@ViewData["TotalTaxRules"]</p>
                        </div>
                        <span class="stat-icon" aria-hidden="true"><i class="bi bi-file-earmark-ruled-fill"></i></span>
                    </div>
                    <a asp-controller="Tax" asp-action="Index" class="stat-link">
                        View tax rules <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="actions-card">
        <div class="card-header">
            <i class="bi bi-lightning-charge-fill"></i>Quick Actions
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Employee" asp-action="Create" class="qa-btn qa-employee">
                        <span class="qa-icon"><i class="bi bi-person-plus-fill"></i></span>
                        Add New Employee
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Payroll" asp-action="Create" class="qa-btn qa-payroll">
                        <span class="qa-icon"><i class="bi bi-play-circle-fill"></i></span>
                        Run Payroll
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Attendance" asp-action="Create" class="qa-btn qa-attendance">
                        <span class="qa-icon"><i class="bi bi-clipboard2-check-fill"></i></span>
                        Mark Attendance
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="LMS" asp-action="Create" class="qa-btn qa-leave">
                        <span class="qa-icon"><i class="bi bi-calendar-plus-fill"></i></span>
                        Request Leave
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
