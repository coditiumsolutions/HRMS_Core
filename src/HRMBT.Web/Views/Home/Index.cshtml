@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <style>
        .home-dashboard .setup-intro {
            margin-bottom: 1.25rem;
        }
        .home-dashboard .setup-intro h1 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #00203f;
            margin-bottom: 0.35rem;
        }
        .home-dashboard .setup-intro p {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 0;
        }
        .setup-tile {
            background: #fff;
            border: 1px solid rgba(0, 32, 63, 0.08);
            border-radius: 0.75rem;
            box-shadow: 0 0.25rem 1rem rgba(0, 32, 63, 0.06);
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .setup-tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.35rem rgba(0, 32, 63, 0.12);
        }
        .setup-tile-header {
            background: linear-gradient(90deg, #336b87 0%, #2a5a73 100%);
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.02em;
            border-bottom: 2px solid #d4af37;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }
        .setup-tile-icon {
            width: 2.35rem;
            height: 2.35rem;
            border-radius: 0.4rem;
            background: rgba(212, 175, 55, 0.2);
            border: 1px solid rgba(240, 215, 140, 0.45);
            color: #f0d78c;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }
        .setup-tile-body {
            padding: 1.15rem 1.15rem 1.25rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }
        .setup-tile-body p {
            color: #6c757d;
            font-size: 0.875rem;
            line-height: 1.5;
            margin-bottom: 1.1rem;
            flex: 1;
        }
        .setup-tile-stat {
            font-size: 1.85rem;
            font-weight: 700;
            color: #00203f;
            line-height: 1.1;
            margin: 0 0 0.85rem 0;
            font-variant-numeric: tabular-nums;
        }
        .setup-tile-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-bottom: 0.85rem;
        }
        .setup-tile-meta span {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: #495057;
            background: #f8fafc;
            border: 1px solid #e9ecef;
            border-radius: 0.25rem;
            padding: 0.2rem 0.5rem;
        }
        .setup-tile-meta span i {
            color: #d4af37;
            margin-right: 0.25rem;
        }
        .setup-tile-actions {
            margin-top: auto;
        }
        .setup-tile-actions .btn {
            min-width: 8.5rem;
        }
        .home-dashboard .actions-card {
            background: #fff;
            border: 1px solid rgba(0, 32, 63, 0.08);
            border-radius: 0.75rem;
            box-shadow: 0 0.25rem 1rem rgba(0, 32, 63, 0.06);
            overflow: hidden;
            margin-top: 0.25rem;
        }
        .home-dashboard .actions-card .card-header {
            background: linear-gradient(90deg, #336b87 0%, #2a5a73 100%);
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.02em;
            border-bottom: 2px solid #d4af37;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .home-dashboard .actions-card .card-header i {
            color: #f0d78c;
        }
        .home-dashboard .actions-card .card-body {
            padding: 1.15rem;
        }
        .home-dashboard .qa-btn {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.75rem 0.9rem;
            border-radius: 0.5rem;
            border: 1px solid #e9ecef;
            background: #f8fafc;
            color: #00203f;
            font-weight: 600;
            font-size: 0.875rem;
            text-decoration: none;
            height: 100%;
            transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
        }
        .home-dashboard .qa-btn:hover {
            background: #fff8e1;
            border-color: #d4af37;
            color: #00203f;
            transform: translateY(-2px);
        }
        .home-dashboard .qa-icon {
            width: 2.1rem;
            height: 2.1rem;
            border-radius: 0.35rem;
            background: rgba(212, 175, 55, 0.18);
            border: 1px solid rgba(212, 175, 55, 0.4);
            color: #856404;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
    </style>
}

<div class="home-dashboard">
    <div class="setup-intro">
        <h1><i class="bi bi-speedometer2 me-2" style="color:#d4af37;"></i>HR Management Dashboard</h1>
        <p>Overview of people, attendance, leave, and payroll at a glance.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
                    <span>Total Employees</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-people"></i>Workforce</span>
                    </div>
                    <p class="setup-tile-stat">@ViewData["TotalEmployees"]</p>
                    <p>All employee records in the system.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-controller="Employee" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View all
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-person-check-fill"></i></span>
                    <span>Active Employees</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-check2-circle"></i>Active</span>
                    </div>
                    <p class="setup-tile-stat">@ViewData["ActiveEmployees"]</p>
                    <p>Employees currently marked as active.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-controller="Employee" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View active
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-calendar2-check-fill"></i></span>
                    <span>Today's Attendance</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-calendar-day"></i>Today</span>
                    </div>
                    <p class="setup-tile-stat">@ViewData["TodayAttendance"]</p>
                    <p>Attendance records logged for today.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-controller="Attendance" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View attendance
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                    <span>Pending Leave Requests</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-clock-history"></i>Pending</span>
                    </div>
                    <p class="setup-tile-stat">@ViewData["PendingLeaves"]</p>
                    <p>Leave requests waiting for approval.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-controller="LMS" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View leaves
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></span>
                    <span>Total Payroll Records</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-wallet2"></i>Payroll</span>
                    </div>
                    <p class="setup-tile-stat">@ViewData["TotalPayrolls"]</p>
                    <p>Payslip and payroll runs on record.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-controller="Payroll" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View payroll
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-file-earmark-ruled-fill"></i></span>
                    <span>Tax Rules</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-percent"></i>Tax</span>
                    </div>
                    <p class="setup-tile-stat">@ViewData["TotalTaxRules"]</p>
                    <p>Configured tax slabs and rules.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-controller="Tax" asp-action="Index">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View tax rules
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="actions-card">
        <div class="card-header">
            <i class="bi bi-lightning-charge-fill"></i>Quick Actions
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Employee" asp-action="Create" class="qa-btn">
                        <span class="qa-icon"><i class="bi bi-person-plus-fill"></i></span>
                        Add New Employee
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Payroll" asp-action="Create" class="qa-btn">
                        <span class="qa-icon"><i class="bi bi-play-circle-fill"></i></span>
                        Run Payroll
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Attendance" asp-action="Create" class="qa-btn">
                        <span class="qa-icon"><i class="bi bi-clipboard2-check-fill"></i></span>
                        Mark Attendance
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="LMS" asp-action="Create" class="qa-btn">
                        <span class="qa-icon"><i class="bi bi-calendar-plus-fill"></i></span>
                        Request Leave
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
