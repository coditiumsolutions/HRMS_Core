@model HRMBT.Web.Models.ViewModels.EmployeeDashboardVM

@{
    ViewData["Title"] = "Employee Dashboard";
    const int topSlices = 8;
    List<(string Name, int Count)> TopSlices(List<HRMBT.Web.Models.ViewModels.DepartmentEmployeeCount> source, string noun)
    {
        var list = source.Take(topSlices).Select(d => (Name: d.Department, Count: d.Count)).ToList();
        var rest = source.Skip(topSlices).ToList();
        if (rest.Count > 0) list.Add(("Other (" + rest.Count + " " + noun + ")", rest.Sum(d => d.Count)));
        return list;
    }
    var deptPie = new HRMBT.Web.Models.ViewModels.HeadcountPieVm
    {
        Title = "Employees by Department", Icon = "bi-pie-chart", Total = Model.TotalEmployees,
        Summary = Model.ByDepartment.Count + " departments",
        Slices = TopSlices(Model.ByDepartment, "departments")
    };
    var projectPie = new HRMBT.Web.Models.ViewModels.HeadcountPieVm
    {
        Title = "Employees by Project", Icon = "bi-kanban", Total = Model.TotalEmployees,
        Summary = Model.ByProject.Count + " projects",
        Slices = TopSlices(Model.ByProject, "projects")
    };
    var maxCount = Model.ByDepartment.Any() ? Model.ByDepartment.Max(d => d.Count) : 0;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <style>
        .kpi-card {
            background: #fff;
            border: 1px solid rgba(0, 32, 63, 0.08);
            border-radius: 0.6rem;
            box-shadow: 0 0.2rem 0.75rem rgba(0, 32, 63, 0.06);
            padding: 0.5rem 0.8rem 0.5rem 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.65rem;
            position: relative;
            overflow: hidden;
            min-width: 0;
        }
        .kpi-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #d4af37; }
        .kpi-card .kpi-icon {
            width: 2.1rem; height: 2.1rem; border-radius: 0.45rem;
            display: inline-flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1.05rem; flex-shrink: 0;
        }
        .kpi-card .kpi-text { min-width: 0; }
        .kpi-card .kpi-label { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6c757d; line-height: 1.2; }
        .kpi-card .kpi-value { font-size: 1.3rem; font-weight: 700; color: #00203f; line-height: 1.15; overflow-wrap: anywhere; }
        .kpi-card .kpi-value.kpi-value-text { font-size: 0.95rem; line-height: 1.2; white-space: nowrap; overflow-wrap: normal; overflow: hidden; }
        .kpi-card .kpi-sub   { font-size: 0.72rem; color: #6c757d; line-height: 1.2; }

        .kpi-total    .kpi-icon { background: linear-gradient(135deg, #00203f 0%, #1a4a7a 100%); }
        .kpi-active   .kpi-icon { background: linear-gradient(135deg, #1f7a3a 0%, #2e9c4f 100%); }
        .kpi-leave    .kpi-icon { background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%); }
        .kpi-dept     .kpi-icon { background: linear-gradient(135deg, #b45309 0%, #d4af37 100%); }

        .chart-pane { position: relative; height: 16rem; }
        .dept-key { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 0.1rem 1.5rem; align-content: start; }
        .dept-key li { display: grid; grid-template-columns: 0.8rem 1fr auto; align-items: center; gap: 0.55rem; padding: 0.28rem 0.5rem; border-radius: 0.35rem; font-size: 0.9rem; cursor: default; }
        .dept-key li:hover { background: #fff8e1; }
        .dept-key .swatch { width: 0.8rem; height: 0.8rem; border-radius: 0.2rem; }
        .dept-key .key-name { color: #212529; font-weight: 600; overflow-wrap: anywhere; }
        .dept-key .key-count { font-variant-numeric: tabular-nums; color: #00203f; font-weight: 700; white-space: nowrap; }
        .dept-key .key-count small { color: #6c757d; font-weight: 500; margin-left: 0.25rem; }

        .share-cell { display: flex; align-items: center; gap: 0.6rem; min-width: 9rem; }
        .share-track { flex: 1; height: 0.5rem; background: #f1f3f5; border-radius: 2rem; overflow: hidden; }
        .share-fill { height: 100%; background: linear-gradient(90deg, #00203f 0%, #1a4a7a 60%, #d4af37 100%); border-radius: 2rem; }
        .share-pct { min-width: 3.2rem; text-align: right; font-variant-numeric: tabular-nums; color: #495057; }
        .dept-swatch { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 0.2rem; margin-right: 0.55rem; vertical-align: -0.05rem; }
    </style>
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-0">

        <!-- KPI cards -->
        <div class="row g-2 mb-3">
            <div class="col-sm-6 col-xl">
                <div class="kpi-card kpi-total h-100">
                    <span class="kpi-icon"><i class="bi bi-people-fill"></i></span>
                    <div class="kpi-text">
                        <div class="kpi-label">Total Employees</div>
                        <div class="kpi-value">@Fmt.Int(Model.TotalEmployees)</div>
                        <div class="kpi-sub">@Model.DepartmentCount departments</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl">
                <div class="kpi-card kpi-active h-100">
                    <span class="kpi-icon"><i class="bi bi-check2-circle"></i></span>
                    <div class="kpi-text">
                        <div class="kpi-label">Active</div>
                        <div class="kpi-value">@Fmt.Int(Model.ActiveEmployees)</div>
                        <div class="kpi-sub">@(Model.TotalEmployees == 0 ? "—" : Fmt.Percent((decimal)(Model.ActiveEmployees * 100.0 / Model.TotalEmployees))) of workforce</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl">
                <div class="kpi-card kpi-leave h-100">
                    <span class="kpi-icon"><i class="bi bi-airplane"></i></span>
                    <div class="kpi-text">
                        <div class="kpi-label">On Leave</div>
                        <div class="kpi-value">@Fmt.Int(Model.OnLeaveEmployees)</div>
                        <div class="kpi-sub">currently away</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl">
                <div class="kpi-card kpi-dept h-100">
                    <span class="kpi-icon"><i class="bi bi-diagram-3"></i></span>
                    <div class="kpi-text">
                        <div class="kpi-label">Top Department</div>
                        <div class="kpi-value kpi-value-text">
                            @(Model.TopDepartment?.Department ?? "—")
                        </div>
                        <div class="kpi-sub">@(Model.TopDepartment == null ? "no data" : Fmt.Int(Model.TopDepartment.Count) + " employees")</div>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.ByDepartment.Any())
        {
            <div class="grid-card">
                <div class="card-header"><i class="bi bi-bar-chart"></i>Employees by Department</div>
                <div class="card-body">
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No employee data yet</h5>
                        <p class="mb-3">Add employees to see department distribution.</p>
                        <a asp-action="Create" class="btn btn-action-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add Employee
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3 mb-3">
                <div class="col-12"><partial name="_HeadcountPie" model="deptPie" /></div>
                <div class="col-12"><partial name="_HeadcountPie" model="projectPie" /></div>
            </div>

            <div class="grid-card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                    <span><i class="bi bi-list-ul"></i>Department breakdown</span>
                </div>
                <div class="card-body">
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th class="text-end">Employees</th>
                                    <th data-align="none">Share of workforce</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.ByDepartment.Count; i++)
                                {
                                    var d = Model.ByDepartment[i];
                                    var pct = maxCount == 0 ? 0 : Math.Round((d.Count * 100.0) / maxCount);
                                    var share = Model.TotalEmployees == 0 ? 0 : Math.Round((d.Count * 100.0) / Model.TotalEmployees, 1);
                                    <tr>
                                        <td>@d.Department</td>
                                        <td class="text-end">@Fmt.Int(d.Count)</td>
                                        <td>
                                            <div class="share-cell">
                                                <div class="share-track"><div class="share-fill" style="width:@pct%;"></div></div>
                                                <span class="share-pct">@Fmt.Percent((decimal)share)</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        // Text stat cards never wrap: shrink the font until the name fits its card
        (function () {
            function fit() {
                document.querySelectorAll('.kpi-value-text').forEach(function (el) {
                    el.style.fontSize = '';
                    var size = parseFloat(getComputedStyle(el).fontSize);
                    while (el.scrollWidth > el.clientWidth && size > 9) { size -= 0.5; el.style.fontSize = size + 'px'; }
                });
            }
            fit();
            window.addEventListener('resize', fit);
            window.addEventListener('load', fit);
        })();
    </script>
    @if (Model.ByDepartment.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                var palette = ['#00203f','#d4af37','#0f766e','#b91c1c','#5b21b6','#1d4ed8','#b45309','#db2777'];
                document.querySelectorAll('canvas[data-pie]').forEach(function (canvas) {
                    var labels = JSON.parse(canvas.getAttribute('data-labels'));
                    var values = JSON.parse(canvas.getAttribute('data-values'));
                    var colors = labels.map(function (_, i) { return i < palette.length ? palette[i] : '#9aa5b1'; });
                    var card = canvas.closest('.pie-card');
                    card.querySelectorAll('[data-swatch]').forEach(function (el) {
                        el.style.background = colors[Number(el.getAttribute('data-swatch'))];
                    });
                    var total = values.reduce(function (a, b) { return a + b; }, 0);
                    var pie = new Chart(canvas, {
                        type: 'pie',
                        data: { labels: labels, datasets: [{ data: values, backgroundColor: colors, borderColor: '#fff', borderWidth: 2, hoverOffset: 6 }] },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            layout: { padding: 6 },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    bodyFont: { size: 14 },
                                    callbacks: {
                                        label: function (ctx) {
                                            var pct = total === 0 ? 0 : Math.round((ctx.parsed / total) * 100);
                                            return ' ' + ctx.label + ': ' + ctx.parsed + ' (' + pct + '%)';
                                        }
                                    }
                                }
                            }
                        }
                    });
                    // hovering a key row highlights its slice
                    card.querySelectorAll('.dept-key li').forEach(function (li) {
                        var i = Number(li.getAttribute('data-index'));
                        li.addEventListener('mouseenter', function () {
                            pie.setActiveElements([{ datasetIndex: 0, index: i }]);
                            pie.tooltip.setActiveElements([{ datasetIndex: 0, index: i }], { x: 0, y: 0 });
                            pie.update();
                        });
                        li.addEventListener('mouseleave', function () {
                            pie.setActiveElements([]);
                            pie.tooltip.setActiveElements([], { x: 0, y: 0 });
                            pie.update();
                        });
                    });
                });
            })();
        </script>
    }
}
