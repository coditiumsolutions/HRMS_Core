@model HRMBT.Web.Models.Allowance

@{
    ViewData["Title"] = "Edit allowance";
    ViewData["Module"] = "Allowances";
    var titleName = string.IsNullOrWhiteSpace(Model.Name) ? "Edit allowance" : $"Edit allowance ({Model.Name.Trim()})";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
    <style>
        .allowance-edit-compact .card-body { padding: 0.5rem 0.65rem !important; }
        .allowance-edit-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        .allowance-edit-table .pd-label {
            width: 14%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.875rem;
            font-weight: 600;
            color: #000;
            background: #f8fafc;
            border-right: 1px solid #eef0f2;
        }
        .allowance-edit-table .pd-value {
            width: 36%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.875rem;
            color: #0d6efd;
        }
        .allowance-edit-table .form-control,
        .allowance-edit-table .form-select {
            font-size: 0.8125rem;
            min-height: 1.75rem;
            height: 1.75rem;
            padding: 0.15rem 0.4rem;
            color: #0d6efd;
            line-height: 1.25;
        }
        .allowance-edit-table .form-control:focus,
        .allowance-edit-table .form-select:focus {
            color: #0a58ca;
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.2);
        }
        .allowance-edit-table .form-check {
            margin: 0;
            min-height: auto;
            padding-top: 0;
            padding-bottom: 0;
        }
        .allowance-edit-table .form-check-label {
            font-size: 0.8125rem;
            color: #0d6efd;
        }
        .allowance-edit-table tr { border-bottom: 1px solid #eef0f2; }
        .allowance-edit-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            justify-content: flex-end;
            align-items: center;
            padding: 0.65rem 0.85rem;
        }
        .allowance-edit-actions .btn,
        .allowance-edit-actions .btn-action-primary,
        .allowance-edit-actions .btn-action-secondary,
        .allowance-edit-actions .btn-action-outline {
            border-radius: 0.25rem !important;
            padding: 0.2rem 0.6rem !important;
            font-size: 0.8125rem !important;
            font-weight: 600;
            min-height: 1.6rem !important;
            height: 1.6rem;
            line-height: 1.2 !important;
            white-space: nowrap;
        }
        .allowance-edit-compact .grid-card .card-header {
            font-size: 0.9rem;
        }
    </style>
}

<div class="payslip-page allowance-edit-compact py-3">
    <div class="container-fluid px-3 px-lg-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />
            <input type="hidden" asp-for="CreatedBy" />

            <div class="grid-card mb-3">
                <div class="card-header">
                    <span><i class="bi bi-pencil"></i>@titleName</span>
                </div>
                <div class="card-body p-0">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger m-3 mb-0" role="alert">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="payroll-details-table allowance-edit-table mb-0">
                            <tbody>
                                <tr>
                                    <th scope="row" class="pd-label">Employee ID</th>
                                    <td class="pd-value">
                                        <input type="text" class="form-control" value="@ViewBag.EmployeeCode" readonly tabindex="-1" />
                                    </td>
                                    <th scope="row" class="pd-label">Employee</th>
                                    <td class="pd-value">
                                        <input type="hidden" asp-for="EmployeeId" />
                                        <input type="text" class="form-control" value="@ViewBag.EmployeeDisplayName" readonly tabindex="-1" />
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Allowance Name</th>
                                    <td class="pd-value">
                                        <select asp-for="Name" class="form-select" asp-items="ViewBag.AllowanceName">
                                            <option value="">— Select name —</option>
                                        </select>
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </td>
                                    <th scope="row" class="pd-label">Allowance type</th>
                                    <td class="pd-value">
                                        <select asp-for="AllowanceType" class="form-select" asp-items="ViewBag.AllowanceType">
                                            <option value="">— Select type —</option>
                                        </select>
                                        <span asp-validation-for="AllowanceType" class="text-danger"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Frequency</th>
                                    <td class="pd-value">
                                        <select asp-for="Frequency" class="form-select" asp-items="ViewBag.Frequency"></select>
                                        <span asp-validation-for="Frequency" class="text-danger"></span>
                                    </td>
                                    <th scope="row" class="pd-label">Amount</th>
                                    <td class="pd-value">
                                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" id="Amount" />
                                        <div id="fuelCalcHint" class="form-text text-primary d-none mb-0" style="font-size:0.7rem;"></div>
                                        <span asp-validation-for="Amount" class="text-danger"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Quantity</th>
                                    <td class="pd-value">
                                        <input asp-for="Quantity" class="form-control" type="number" step="1" min="0" />
                                        <span asp-validation-for="Quantity" class="text-danger"></span>
                                    </td>
                                    <th scope="row" class="pd-label">Percentage-based</th>
                                    <td class="pd-value">
                                        <div class="form-check">
                                            <input asp-for="IsPercentage" class="form-check-input" />
                                            <label asp-for="IsPercentage" class="form-check-label"></label>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Percentage (%)</th>
                                    <td class="pd-value">
                                        <input asp-for="PercentageValue" class="form-control" type="number" step="0.01" min="0" max="100" />
                                        <span asp-validation-for="PercentageValue" class="text-danger"></span>
                                    </td>
                                    <th scope="row" class="pd-label">Effective date</th>
                                    <td class="pd-value">
                                        <input asp-for="EffectiveDate" class="form-control" type="date" />
                                        <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">End date</th>
                                    <td class="pd-value">
                                        <input asp-for="EndDate" class="form-control" type="date" />
                                        <span asp-validation-for="EndDate" class="text-danger"></span>
                                    </td>
                                    <th scope="row" class="pd-label">Active</th>
                                    <td class="pd-value">
                                        <div class="form-check">
                                            <input asp-for="IsActive" class="form-check-input" />
                                            <label asp-for="IsActive" class="form-check-label"></label>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Remarks</th>
                                    <td class="pd-value" colspan="3">
                                        <input asp-for="Remarks" class="form-control" maxlength="500" />
                                        <span asp-validation-for="Remarks" class="text-danger"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="allowance-edit-actions">
                        <button type="submit" class="btn btn-sm btn-action-primary"><i class="bi bi-check2 me-1"></i>Save</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-action-outline">Details</a>
                        <a asp-action="Index" class="btn btn-sm btn-action-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FuelAllowanceFormScript" />
}
