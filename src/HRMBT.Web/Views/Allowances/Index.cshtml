@model HRMBT.Web.Models.PaginatedList<HRMBT.Web.Models.Allowance>

@{
    ViewData["Title"] = "Allowances";
    ViewData["Module"] = "Allowances";
    var editBaseUrl = Url.Action("Edit", "Allowances");
    var deleteBaseUrl = Url.Action("Delete", "Allowances");
    var detailsBaseUrl = Url.Action("Details", "Allowances");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <style>
        .employee-list-page.allowances-index-compact {
            padding-top: 0.75rem !important;
            padding-bottom: 1rem !important;
        }
        .employee-list-page.allowances-index-compact .filter-card,
        .employee-list-page.allowances-index-compact .grid-card {
            margin-bottom: 0.75rem !important;
        }
        .employee-list-page.allowances-index-compact .filter-card .card-body {
            padding: 0.5rem 0.75rem !important;
        }
        .employee-list-page.allowances-index-compact .filter-card .form-label {
            font-size: 0.72rem;
            margin-bottom: 0.15rem;
        }
        .employee-list-page.allowances-index-compact .filter-card .form-select,
        .employee-list-page.allowances-index-compact .filter-card .form-control {
            font-size: 0.8rem;
            min-height: 1.85rem;
            padding: 0.2rem 0.45rem;
        }
        .employee-list-page.allowances-index-compact .btn-filter-apply {
            border-radius: 0.25rem !important;
            padding: 0.2rem 0.65rem !important;
            font-size: 0.78rem !important;
            white-space: nowrap;
        }
        .employee-list-page.allowances-index-compact table.employee-grid {
            font-size: 0.875rem;
        }
        .employee-list-page.allowances-index-compact table.employee-grid thead th {
            padding: 0.4rem 0.5rem;
            font-size: 0.78rem;
            white-space: nowrap;
        }
        .employee-list-page.allowances-index-compact table.employee-grid tbody td {
            padding: 0.35rem 0.5rem;
            vertical-align: middle;
            line-height: 1.3;
        }
        .employee-list-page.allowances-index-compact table.employee-grid .emp-name {
            font-size: 0.875rem;
            font-weight: 600;
            line-height: 1.25;
        }
        .employee-list-page.allowances-index-compact table.employee-grid .emp-meta {
            font-size: 0.75rem;
            line-height: 1.2;
            margin-top: 0.05rem;
        }
        .employee-list-page.allowances-index-compact table.employee-grid .status-pill {
            font-size: 0.72rem;
            padding: 0.12rem 0.45rem;
        }
        .employee-list-page.allowances-index-compact .grid-selection-actions .btn {
            padding: 0.15rem 0.45rem !important;
            font-size: 0.72rem !important;
        }
        .employee-list-page.allowances-index-compact .pagination {
            margin-bottom: 0.35rem !important;
        }
        .employee-list-page.allowances-index-compact .pagination .page-link {
            padding: 0.2rem 0.45rem;
            font-size: 0.75rem;
        }
    </style>
}

<div class="employee-list-page allowances-index-compact py-3">
    <div class="container-fluid px-3 px-lg-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3 py-2" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3 py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card filter-card-compact mb-3">
            <div class="card-header"><span><i class="bi bi-funnel"></i>Search &amp; filters</span></div>
            <div class="card-body p-2 p-lg-3">
                <form asp-action="Index" method="get" class="row g-2 align-items-end" onsubmit="document.getElementById('allowPageInput').value = '1';">
                    <input type="hidden" name="page" id="allowPageInput" value="1" />
                    <div class="col-12 col-md">
                        <label class="form-label" for="deptId">Department</label>
                        <select name="deptId" id="deptId" class="form-select form-select-sm" asp-items="ViewBag.DepartmentFilterOptions"
                                onchange="document.getElementById('allowPageInput').value = '1'; this.form.submit();"></select>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="empSearch">Employee ID or name</label>
                        <input type="text" name="empSearch" id="empSearch" class="form-control form-control-sm" value="@ViewBag.CurrentEmpSearch" placeholder="e.g. Shahid Ghauri or 860" />
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="allowanceType">Allow. Type</label>
                        <select name="allowanceType" id="allowanceType" class="form-select form-select-sm" asp-items="ViewBag.AllowanceTypeFilterOptions"></select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-filter-apply btn-action-primary w-100">
                            <i class="bi bi-funnel-fill me-1"></i>Apply
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Allowances</span>
                @if (Model != null && Model.Any())
                {
                    <div class="grid-selection-actions">
                        <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No allowances found</h5>
                        <p class="mb-0">Try another department or employee search.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="allowancesGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-details-base="@detailsBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>Employee</th>
                                    <th>Allow. Name</th>
                                    <th>Allow. Type</th>
                                    <th>Frequency</th>
                                    <th class="text-end col-salary">Amount</th>
                                    <th class="text-end">Qty</th>
                                    <th>%</th>
                                    <th class="text-end">% value</th>
                                    <th>Effective</th>
                                    <th>End</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr data-record-id="@item.Id" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedAllowance" value="@item.Id" aria-label="Select allowance @item.Id" />
                                        </td>
                                        <td>
                                            <div class="emp-name">@(item.Employee?.EmployeeName ?? "—")</div>
                                            <div class="emp-meta">@(item.Employee?.EmployeeID ?? item.EmployeeId.ToString())</div>
                                        </td>
                                        <td>@item.Name</td>
                                        <td>@item.AllowanceType</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Frequency) ? "—" : item.Frequency)</td>
                                        <td class="text-end salary col-salary">@item.Amount.ToString("N2")</td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td>@(item.IsPercentage ? "Y" : "N")</td>
                                        <td class="text-end">@(item.PercentageValue?.ToString("N2") ?? "—")</td>
                                        <td class="text-nowrap">@item.EffectiveDate.ToString("dd-MMM-yy")</td>
                                        <td class="text-nowrap">@(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd-MMM-yy") : "—")</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="status-pill status-active">Y</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-inactive">N</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav aria-label="Allowance pagination" class="mt-2 px-3 pb-3">
                        @if (Model.TotalPages > 1)
                        {
                            <ul class="pagination justify-content-center mb-2">
                                @{
                                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                                    int startPage = Math.Max(1, Model.PageIndex - 2);
                                    int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                    if (endPage - startPage < 4)
                                    {
                                        if (startPage == 1) { endPage = Math.Min(Model.TotalPages, startPage + 4); }
                                        else if (endPage == Model.TotalPages) { startPage = Math.Max(1, endPage - 4); }
                                    }
                                }
                                <li class="page-item @prevDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="1"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-allowanceType="@ViewBag.CurrentAllowanceType">&laquo;&laquo;</a>
                                </li>
                                <li class="page-item @prevDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-allowanceType="@ViewBag.CurrentAllowanceType">&laquo;</a>
                                </li>
                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    var active = i == Model.PageIndex ? "active" : "";
                                    <li class="page-item @active">
                                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                                           asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-allowanceType="@ViewBag.CurrentAllowanceType">@i</a>
                                    </li>
                                }
                                <li class="page-item @nextDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-allowanceType="@ViewBag.CurrentAllowanceType">&raquo;</a>
                                </li>
                                <li class="page-item @nextDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-allowanceType="@ViewBag.CurrentAllowanceType">&raquo;&raquo;</a>
                                </li>
                            </ul>
                        }
                        <div class="text-center text-muted small">
                            Page @Model.PageIndex of @Model.TotalPages (Total: @Model.TotalCount records)
                        </div>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
