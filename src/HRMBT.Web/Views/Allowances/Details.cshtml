@model HRMBT.Web.Models.Allowance

@{
    ViewData["Title"] = "Allowance details";
    ViewData["Module"] = "Allowances";
    string Show(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v!;
    var titleName = string.IsNullOrWhiteSpace(Model.Name) ? "Allowance" : $"Allowance ({Model.Name.Trim()})";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
    <style>
        .allowance-details-compact .card-body { padding: 0.5rem 0.65rem !important; }
        .allowance-details-compact .grid-card,
        .allowance-details-compact .section-card { margin-bottom: 0.75rem !important; }
        .allowance-details-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        .allowance-details-table .pd-label {
            width: 14%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.875rem;
            font-weight: 600;
            color: #000;
            background: #f8fafc;
            border-right: 1px solid #eef0f2;
        }
        .allowance-details-table .pd-value {
            width: 36%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.875rem;
            color: #0d6efd;
            word-break: break-word;
        }
        .allowance-details-table tr { border-bottom: 1px solid #eef0f2; }
        .allowance-details-compact .allowance-details-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            justify-content: flex-end;
            align-items: center;
            margin-left: auto;
        }
        .allowance-details-compact .grid-card .card-header {
            font-size: 0.9rem;
        }
        .allowance-details-compact .allowance-details-actions .btn,
        .allowance-details-compact .allowance-details-actions .btn-action-primary,
        .allowance-details-compact .allowance-details-actions .btn-action-secondary,
        .allowance-details-compact .allowance-details-actions .btn-action-outline {
            border-radius: 0.25rem !important;
            padding: 0.2rem 0.6rem !important;
            font-size: 0.8125rem !important;
            font-weight: 600;
            min-height: 1.6rem !important;
            height: 1.6rem;
            line-height: 1.2 !important;
            white-space: nowrap;
        }
    </style>
}

<div class="payslip-page allowance-details-compact py-3">
    <div class="container-fluid px-3 px-lg-4">
        <div class="grid-card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-cash-stack"></i>@titleName</span>
                <div class="allowance-details-actions">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-grid-edit"><i class="bi bi-pencil me-1"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-grid-delete"><i class="bi bi-trash me-1"></i>Delete</a>
                    <a asp-action="Index" class="btn btn-sm btn-action-secondary">Back</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="allowance-details-table mb-0">
                        <tbody>
                            <tr>
                                <th scope="row" class="pd-label">Employee</th>
                                <td class="pd-value">@(Model.Employee?.EmployeeName ?? "—")</td>
                                <th scope="row" class="pd-label">Employee ID</th>
                                <td class="pd-value">@(Model.Employee?.EmployeeID ?? Model.EmployeeId.ToString())</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Allowance Name</th>
                                <td class="pd-value">@Show(Model.Name)</td>
                                <th scope="row" class="pd-label">Allowance type</th>
                                <td class="pd-value">@Show(Model.AllowanceType)</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Frequency</th>
                                <td class="pd-value">@Show(Model.Frequency)</td>
                                <th scope="row" class="pd-label">Amount</th>
                                <td class="pd-value">@Model.Amount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Quantity</th>
                                <td class="pd-value">@Model.Quantity</td>
                                <th scope="row" class="pd-label">Percentage-based</th>
                                <td class="pd-value">@(Model.IsPercentage ? "Yes" : "No")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Percentage (%)</th>
                                <td class="pd-value">@(Model.PercentageValue?.ToString("N2") ?? "—")</td>
                                <th scope="row" class="pd-label">Effective date</th>
                                <td class="pd-value">@Model.EffectiveDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">End date</th>
                                <td class="pd-value">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                                <th scope="row" class="pd-label">Active</th>
                                <td class="pd-value">@(Model.IsActive ? "Yes" : "No")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Remarks</th>
                                <td class="pd-value" colspan="3">@Show(Model.Remarks)</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Created</th>
                                <td class="pd-value">@Model.CreatedDate.ToString("g") · @Show(Model.CreatedBy)</td>
                                <th scope="row" class="pd-label">Modified</th>
                                <td class="pd-value">@(Model.ModifiedDate.HasValue ? Model.ModifiedDate.Value.ToString("g") + " · " + Show(Model.ModifiedBy) : "—")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
