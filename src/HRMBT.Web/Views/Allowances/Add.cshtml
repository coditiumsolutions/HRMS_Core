@model HRMBT.Web.Models.PaginatedList<HRMBT.Web.Models.Employee>

@{
    ViewData["Title"] = "Add Allowances";
    ViewData["Module"] = "Allowances";
    var empModel = Model;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
    <style>
        .payslip-page .btn-filter-apply,
        .payslip-page .btn-rect {
            border-radius: 0.25rem !important;
            padding: 0.25rem 0.75rem !important;
            white-space: nowrap;
            font-size: 0.8125rem;
            min-height: 1.75rem;
            line-height: 1.2;
        }
        .allowances-add-compact .card-body {
            padding: 0.65rem 0.85rem !important;
        }
        .allowances-add-compact .form-label {
            font-size: 0.8125rem;
            margin-bottom: 0.2rem;
        }
        .allowances-add-compact .form-control,
        .allowances-add-compact .form-select {
            font-size: 0.8125rem;
            min-height: 1.75rem;
            height: 1.75rem;
            padding: 0.15rem 0.4rem;
        }
        .allowances-add-compact .row {
            --bs-gutter-y: 0.5rem;
            --bs-gutter-x: 0.65rem;
        }
        .allowances-add-compact .btn-action-secondary,
        .allowances-add-compact .btn-action-outline,
        .allowances-add-compact .btn-action-primary {
            border-radius: 0.25rem !important;
            padding: 0.25rem 0.75rem !important;
            font-size: 0.8125rem;
            min-height: 1.75rem;
            line-height: 1.2;
        }
        .allowances-add-compact .filter-card,
        .allowances-add-compact .section-card,
        .allowances-add-compact .grid-card {
            margin-bottom: 0.85rem !important;
        }
        .allowances-add-compact .payslip-grid tbody tr:nth-child(odd) {
            background-color: #ffffff;
        }
        .allowances-add-compact .payslip-grid tbody tr:nth-child(even) {
            background-color: #eef4fb;
        }
        .allowances-add-compact .payslip-grid tbody tr:hover {
            background-color: #dceaf8;
        }
        .allowance-bulk-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        .allowance-bulk-table .pd-label {
            width: 14%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #000;
            background: #f8fafc;
            border-right: 1px solid #eef0f2;
        }
        .allowance-bulk-table .pd-value {
            width: 36%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.8125rem;
            color: #0d6efd;
        }
        .allowance-bulk-table tr {
            border-bottom: 1px solid #eef0f2;
        }
        .allowance-bulk-table .form-control,
        .allowance-bulk-table .form-select {
            color: #0d6efd;
            width: 100%;
        }
        .allowance-bulk-table .form-check {
            margin: 0;
            min-height: auto;
        }
        .allowance-bulk-table .form-check-label {
            font-size: 0.8125rem;
            color: #0d6efd;
        }
        .allowance-bulk-actions {
            padding: 0.5rem 0.55rem 0;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
            justify-content: flex-end;
        }
    </style>
}

<div class="payslip-page allowances-add-compact py-3">
    <div class="container-fluid px-3 px-lg-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card mb-3">
            <div class="card-header"><i class="bi bi-funnel"></i>Filter employees</div>
            <div class="card-body">
                <form asp-action="Add" method="get" class="row align-items-end" onsubmit="document.getElementById('empPageInput').value = '1';">
                    <input type="hidden" name="ePage" id="empPageInput" value="@ViewBag.CurrentEPage" />
                    <div class="col-12 col-md">
                        <label class="form-label" for="deptId">Department</label>
                        <select name="deptId" id="deptId" class="form-select" asp-items="ViewBag.DepartmentFilterOptions"
                                onchange="document.getElementById('empPageInput').value = '1'; this.form.submit();"></select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-filter-apply btn-action-primary">
                            <i class="bi bi-search me-1"></i>Apply
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <form asp-action="BulkCreateAllowances" method="post" id="bulkAllowanceForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="deptId" value="@(ViewBag.CurrentDeptId)" />
            <input type="hidden" name="ePage" value="@ViewBag.CurrentEPage" />

            <div class="section-card mb-3">
                <div class="card-header"><i class="bi bi-ui-checks-grid"></i>Add allowance to selected employees</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="allowance-bulk-table mb-0">
                            <tbody>
                                <tr>
                                    <th scope="row" class="pd-label">Allowance type</th>
                                    <td class="pd-value">
                                        <select name="allowanceName" id="allowanceName" class="form-select" asp-items="ViewBag.AllowanceNameOptions" required></select>
                                    </td>
                                    <th scope="row" class="pd-label">Name</th>
                                    <td class="pd-value">
                                        <input type="text" name="name" id="name" class="form-control" maxlength="200" required />
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Amount</th>
                                    <td class="pd-value">
                                        <input type="number" name="amount" id="amount" class="form-control" step="0.01" min="0" value="0" required />
                                        <div id="fuelCalcHint" class="form-text text-primary d-none mb-0" style="font-size:0.7rem;"></div>
                                    </td>
                                    <th scope="row" class="pd-label">Quantity</th>
                                    <td class="pd-value">
                                        <input type="number" name="quantity" id="quantity" class="form-control" step="1" min="0" value="1" required />
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Percentage-based</th>
                                    <td class="pd-value">
                                        <div class="form-check">
                                            <input type="checkbox" name="isPercentage" id="isPercentage" class="form-check-input" value="true" />
                                            <label class="form-check-label" for="isPercentage">Yes</label>
                                        </div>
                                    </td>
                                    <th scope="row" class="pd-label">Percentage (%)</th>
                                    <td class="pd-value">
                                        <input type="number" name="percentageValue" id="percentageValue" class="form-control" step="0.01" min="0" max="100" />
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Effective date</th>
                                    <td class="pd-value">
                                        <input type="date" name="effectiveDate" id="effectiveDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                    </td>
                                    <th scope="row" class="pd-label">End date</th>
                                    <td class="pd-value">
                                        <input type="date" name="endDate" id="endDate" class="form-control" />
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Remarks</th>
                                    <td class="pd-value" colspan="3">
                                        <input type="text" name="remarks" id="remarks" class="form-control" maxlength="500" placeholder="Optional remarks" />
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label"></th>
                                    <td class="pd-value" colspan="3">
                                        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-end">
                                            <span class="text-muted small"><span id="selectedCount">0</span> selected</span>
                                            <button type="submit" class="btn btn-rect btn-action-primary" onclick="return confirmBulkAdd()">
                                                <i class="bi bi-plus-circle me-1"></i>Add to selected
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </form>

        <div class="grid-card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-people"></i>Employees</span>
                @if (empModel != null && empModel.Any())
                {
                    <span class="small">@empModel.StartRecord–@empModel.EndRecord of @empModel.TotalCount</span>
                }
            </div>
            <div class="card-body">
                @if (empModel == null || !empModel.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-person-x"></i>
                        <h5 class="mb-1">No employees match</h5>
                        <p class="mb-0">Change department, then click Apply.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="payslip-grid">
                            <thead>
                                <tr>
                                    <th style="width: 56px;">
                                        <input type="checkbox" id="selectAllCheckbox" class="form-check-input" onclick="toggleAllEmp(this)" title="Select all on this page" />
                                    </th>
                                    <th class="col-payroll-id">Uid</th>
                                    <th>Employee</th>
                                    <th>Department</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in empModel)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" form="bulkAllowanceForm" name="selectedEmployeeIds" value="@item.uid" class="employee-checkbox form-check-input" />
                                        </td>
                                        <td class="col-payroll-id text-muted small font-monospace">@item.uid</td>
                                        <td>
                                            <div class="fw-semibold">@item.EmployeeName</div>
                                            <div class="text-muted small">@item.EmployeeID</div>
                                        </td>
                                        <td>@(item.Department ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (empModel != null && empModel.TotalPages > 1)
        {
            var prevE = !empModel.HasPreviousPage ? "disabled" : "";
            var nextE = !empModel.HasNextPage ? "disabled" : "";
            int startE = Math.Max(1, empModel.PageIndex - 2);
            int endE = Math.Min(empModel.TotalPages, empModel.PageIndex + 2);
            if (endE - startE < 4)
            {
                if (startE == 1) { endE = Math.Min(empModel.TotalPages, startE + 4); }
                else if (endE == empModel.TotalPages) { startE = Math.Max(1, endE - 4); }
            }
            <nav aria-label="Employee pagination" class="mb-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @prevE">
                        <a class="page-link" asp-action="Add" asp-route-ePage="1"
                           asp-route-deptId="@ViewBag.CurrentDeptId">&laquo;&laquo;</a>
                    </li>
                    <li class="page-item @prevE">
                        <a class="page-link" asp-action="Add" asp-route-ePage="@(empModel.PageIndex - 1)"
                           asp-route-deptId="@ViewBag.CurrentDeptId">&laquo;</a>
                    </li>
                    @for (int i = startE; i <= endE; i++)
                    {
                        var activeE = i == empModel.PageIndex ? "active" : "";
                        <li class="page-item @activeE">
                            <a class="page-link" asp-action="Add" asp-route-ePage="@i"
                               asp-route-deptId="@ViewBag.CurrentDeptId">@i</a>
                        </li>
                    }
                    <li class="page-item @nextE">
                        <a class="page-link" asp-action="Add" asp-route-ePage="@(empModel.PageIndex + 1)"
                           asp-route-deptId="@ViewBag.CurrentDeptId">&raquo;</a>
                    </li>
                    <li class="page-item @nextE">
                        <a class="page-link" asp-action="Add" asp-route-ePage="@empModel.TotalPages"
                           asp-route-deptId="@ViewBag.CurrentDeptId">&raquo;&raquo;</a>
                    </li>
                </ul>
                <div class="text-center text-muted small">Page @empModel.PageIndex of @empModel.TotalPages</div>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        var fuelPriceUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("FuelPrice", "Allowances") ?? "/Allowances/FuelPrice"));
        var cachedFuelUnit = null;

        function isFuelSelection() {
            var typeSel = document.getElementById('allowanceName');
            var nameEl = document.getElementById('name');
            var type = (typeSel && typeSel.value || '').trim().toLowerCase();
            var name = (nameEl && nameEl.value || '').trim().toLowerCase();
            return type === 'fuel allowance' || type === 'fuel' || name === 'fuel allowance' || name === 'fuel';
        }

        function toggleAllEmp(checkbox) {
            document.querySelectorAll('.employee-checkbox').forEach(cb => cb.checked = checkbox.checked);
            updateSelectedCount();
        }
        function updateSelectedCount() {
            var n = document.querySelectorAll('.employee-checkbox:checked').length;
            var el = document.getElementById('selectedCount');
            if (el) el.textContent = n;
        }

        function updateFuelHint(unitPrice) {
            var amountEl = document.getElementById('amount');
            var qtyEl = document.getElementById('quantity');
            var hint = document.getElementById('fuelCalcHint');
            var amount = parseFloat(amountEl && amountEl.value);
            var qty = parseInt(qtyEl && qtyEl.value, 10);
            if (!isFuelSelection()) {
                if (hint) { hint.classList.add('d-none'); hint.textContent = ''; }
                return;
            }
            if (!isNaN(amount) && amount > 0) {
                if (hint) {
                    hint.classList.remove('d-none');
                    hint.textContent = 'Fuel Allowance: payroll will use Amount ' + amount.toFixed(2) + '.';
                }
                return;
            }
            var unit = (typeof unitPrice === 'number' && !isNaN(unitPrice)) ? unitPrice : 0;
            var q = isNaN(qty) ? 0 : qty;
            var total = unit * q;
            if (hint) {
                hint.classList.remove('d-none');
                hint.textContent = 'Fuel Allowance: Amount empty → payroll uses FuelPrice × Qty = '
                    + unit.toFixed(2) + ' × ' + q + ' = ' + total.toFixed(2);
            }
        }

        function refreshFuelHint() {
            if (!isFuelSelection()) {
                updateFuelHint(null);
                return;
            }
            if (cachedFuelUnit !== null) {
                updateFuelHint(cachedFuelUnit);
                return;
            }
            fetch(fuelPriceUrl, { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    cachedFuelUnit = (data && typeof data.unitPrice === 'number') ? data.unitPrice : 0;
                    updateFuelHint(cachedFuelUnit);
                })
                .catch(function () {
                    cachedFuelUnit = 0;
                    updateFuelHint(0);
                });
        }

        function confirmBulkAdd() {
            var selected = document.querySelectorAll('.employee-checkbox:checked').length;
            if (selected === 0) {
                alert('Please select at least one employee.');
                return false;
            }
            var typeSel = document.getElementById('allowanceName');
            if (!typeSel || !typeSel.value) {
                alert('Please select an allowance type.');
                return false;
            }
            var displayName = (document.getElementById('name') && document.getElementById('name').value || '').trim();
            if (!displayName) {
                alert('Please enter a name.');
                return false;
            }
            var isPct = document.getElementById('isPercentage') && document.getElementById('isPercentage').checked;
            var amount = parseFloat(document.getElementById('amount').value);
            var qty = parseInt(document.getElementById('quantity') && document.getElementById('quantity').value, 10);
            var pct = NaN;
            var fuelMode = isFuelSelection();
            if (!isPct && !fuelMode && (isNaN(amount) || amount < 0)) {
                alert('Enter a valid amount (0 or greater).');
                return false;
            }
            if (fuelMode && (isNaN(amount) || amount <= 0) && (isNaN(qty) || qty <= 0)) {
                alert('For Fuel Allowance enter Amount, or set Quantity so payroll can use FuelPrice × Quantity.');
                return false;
            }
            if (isNaN(qty) || qty < 0 || !Number.isInteger(qty)) {
                alert('Enter a valid quantity (whole number 0 or greater).');
                return false;
            }
            if (isPct) {
                pct = parseFloat(document.getElementById('percentageValue').value);
                if (isNaN(pct) || pct < 0 || pct > 100) {
                    alert('Enter a percentage between 0 and 100.');
                    return false;
                }
            }
            var effective = document.getElementById('effectiveDate') && document.getElementById('effectiveDate').value;
            if (!effective) {
                alert('Please select an effective date.');
                return false;
            }
            var summary = isPct
                ? (pct.toFixed(2) + '%')
                : (fuelMode && (isNaN(amount) || amount <= 0)
                    ? ('FuelPrice × Qty ' + qty)
                    : amount.toFixed(2));
            return confirm('Add allowance “' + displayName + '” (' + summary + ') for ' + selected + ' employee(s)?');
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.employee-checkbox').forEach(cb => {
                cb.addEventListener('change', function () {
                    updateSelectedCount();
                    var allChecked = document.querySelectorAll('.employee-checkbox:checked').length;
                    var total = document.querySelectorAll('.employee-checkbox').length;
                    var sa = document.getElementById('selectAllCheckbox');
                    if (sa) sa.checked = allChecked === total && total > 0;
                });
            });
            updateSelectedCount();

            var typeSel = document.getElementById('allowanceName');
            var nameEl = document.getElementById('name');
            var qtyEl = document.getElementById('quantity');
            var amountEl = document.getElementById('amount');
            if (typeSel) typeSel.addEventListener('change', refreshFuelHint);
            if (nameEl) nameEl.addEventListener('input', refreshFuelHint);
            if (qtyEl) qtyEl.addEventListener('input', refreshFuelHint);
            if (amountEl) amountEl.addEventListener('input', refreshFuelHint);
            refreshFuelHint();
        });
    </script>
}
