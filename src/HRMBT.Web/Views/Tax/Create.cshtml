@model HRMBT.Web.Models.TaxRule

@{
    ViewData["Title"] = "New slab";
    ViewData["Module"] = "Tax";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tax-rules.css" asp-append-version="true" />
}

<div class="employee-list-page tax-page py-3">
    <div class="container-fluid px-0">

        <div class="tax-intro">
            <div>
                <h1>New slab</h1>
                <p>Add one slab to any tax year (July to June). To set up a whole new year with all its slabs at once, use <a asp-action="NewYear">New tax year</a>.</p>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-action-secondary"><i class="bi bi-arrow-left me-1"></i>All tax years</a>
        </div>

        <partial name="_TaxSourceNote" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">
                <strong>The slab was not saved.</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).Distinct())
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post">
            <div class="grid-card mb-3">
                <div class="card-header"><span><i class="bi bi-calendar3"></i>Tax year</span></div>
                <div class="card-body grid-form">
                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label asp-for="TaxYear" class="form-label">Tax year (1 July to 30 June)</label>
                            <select asp-for="TaxYear" class="form-select" asp-items="ViewBag.TaxYears"></select>
                            <div class="form-text">Any tax year. The slab is added to it, and the year is created if it has no slabs yet.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid-card mb-3">
                <div class="card-header"><span><i class="bi bi-table"></i>Slab (annual income)</span></div>
                <div class="card-body grid-form">
                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-3">
                            <label asp-for="MinSalary" class="form-label"></label>
                            <input asp-for="MinSalary" class="form-control" type="number" step="0.01" min="0" />
                            <div class="form-text">Where the slab starts. The rate applies to the part of the income above this.</div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-3">
                            <label asp-for="MaxSalary" class="form-label"></label>
                            <input asp-for="MaxSalary" class="form-control" type="number" step="0.01" min="0" placeholder="No limit" />
                            <div class="form-text">Leave empty for no upper limit (the top slab).</div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-3">
                            <label asp-for="FixedAmount" class="form-label"></label>
                            <input asp-for="FixedAmount" class="form-control" type="number" step="0.01" min="0" />
                            <div class="form-text">Tax already due at the start of the slab (0 for the first taxed slab).</div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-3">
                            <label asp-for="TaxPercentage" class="form-label"></label>
                            <input asp-for="TaxPercentage" class="form-control" type="number" step="0.01" min="0" max="100" />
                            <div class="form-text">Percent charged on the part above the slab start.</div>
                        </div>
                    </div>
                    <div class="form-text mt-3">Annual tax = fixed amount + rate on the part of the annual income above "Annual income from". Monthly tax = annual tax / 12.</div>
                </div>
            </div>

            <div class="action-bar d-flex flex-wrap align-items-center justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-sm btn-action-secondary">Cancel</a>
                <button type="submit" class="btn btn-sm btn-action-primary"><i class="bi bi-check2 me-1"></i>Save slab</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
