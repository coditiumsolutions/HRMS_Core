@model IEnumerable<HRMBT.Web.Models.TaxRule>

@{
    ViewData["Title"] = "Tax rules";
    var hasFilter = ViewBag.HasTaxYearFilter as bool? == true;
    var selectedYear = ViewBag.SelectedTaxYear as string ?? "";
    var editBaseUrl = Url.Action("Edit", "Tax");
    var deleteBaseUrl = Url.Action("Delete", "Tax");
    var detailsBaseUrl = Url.Action("Details", "Tax");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-3 px-lg-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card mb-3">
            <div class="card-header"><span><i class="bi bi-funnel"></i>Tax year</span></div>
            <div class="card-body p-3 p-lg-4">
                <form asp-action="Index" method="get" class="row g-3 align-items-end">
                    <div class="col-12 col-md">
                        <label class="form-label" for="taxYear">Tax year</label>
                        <select name="taxYear" id="taxYear" class="form-select" asp-items="ViewBag.TaxYearFilter"
                                onchange="this.form.submit()"></select>
                    </div>
                </form>
                @if (hasFilter)
                {
                    <p class="text-muted small mb-0 mt-3">
                        Showing <strong>@Model.Count()</strong> slab(s) for tax year <strong>@selectedYear</strong>.
                    </p>
                }
                else
                {
                    <p class="text-muted small mb-0 mt-3">Choose a tax year to load slabs in the grid below.</p>
                }
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Tax slabs</span>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (hasFilter && Model.Any())
                    {
                        <div class="grid-selection-actions">
                            <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                            <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                        </div>
                    }
                    <a asp-action="Create" class="btn btn-sm btn-grid-edit"><i class="bi bi-plus-lg me-1"></i>New slab</a>
                </div>
            </div>
            <div class="card-body">
                @if (hasFilter && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="taxGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-details-base="@detailsBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                                    <th>@Html.DisplayNameFor(model => model.TaxYear)</th>
                                    <th>@Html.DisplayNameFor(model => model.MinSalary)</th>
                                    <th>@Html.DisplayNameFor(model => model.MaxSalary)</th>
                                    <th>@Html.DisplayNameFor(model => model.TaxPercentage)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr data-record-id="@item.Id" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedTax" value="@item.Id" aria-label="Select tax slab @item.Id" />
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                        <td>@Html.DisplayFor(modelItem => item.TaxYear)</td>
                                        <td class="salary col-salary">@Html.DisplayFor(modelItem => item.MinSalary)</td>
                                        <td class="salary col-salary">@Html.DisplayFor(modelItem => item.MaxSalary)</td>
                                        <td>@Html.DisplayFor(modelItem => item.TaxPercentage)%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!hasFilter)
                {
                    <div class="empty-state">
                        <i class="bi bi-funnel"></i>
                        <h5 class="mb-1">Select a tax year</h5>
                        <p class="mb-0">Choose a tax year from the filter above to display tax slabs.</p>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No tax slabs for @selectedYear</h5>
                        <p class="mb-3">Create a slab for this year.</p>
                        <a asp-action="Create" class="btn btn-sm btn-grid-edit"><i class="bi bi-plus-lg me-1"></i>New slab</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
