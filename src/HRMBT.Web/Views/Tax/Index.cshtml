@model IEnumerable<HRMBT.Web.Models.ViewModels.TaxYearCardVM>

@{
    ViewData["Title"] = "Tax rules";
    var cards = Model.ToList();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tax-rules.css" asp-append-version="true" />
}

<div class="employee-list-page tax-page py-3">
    <div class="container-fluid px-0">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="tax-intro">
            <div>
                <h1>Tax rules</h1>
                <p>Income tax slabs for salaried employees, one card per tax year (July to June). Open a card to see its slabs.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="NewYear" class="btn btn-sm btn-grid-edit"><i class="bi bi-calendar-plus me-1"></i>New tax year</a>
                <a asp-action="Create" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus-lg me-1"></i>New slab</a>
            </div>
        </div>

        <partial name="_TaxSourceNote" />

        @if (cards.Count == 0)
        {
            <div class="grid-card">
                <div class="card-body">
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No tax slabs yet</h5>
                        <p class="mb-3">Set up the first tax year with all its slabs.</p>
                        <a asp-action="NewYear" class="btn btn-sm btn-grid-edit"><i class="bi bi-calendar-plus me-1"></i>New tax year</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="tax-year-grid">
                @foreach (var c in cards)
                {
                    <a class="setup-tile" asp-action="Year" asp-route-start="@c.StartYear" title="Open tax year @c.Label">
                        <div class="setup-tile-header">
                            <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-calendar3"></i></span>
                            <span>Tax year @c.Label</span>
                            @if (c.IsCurrent)
                            {
                                <span class="tax-badge">Current</span>
                            }
                        </div>
                        <div class="setup-tile-body">
                            <p class="setup-tile-stat">@c.SlabCount @(c.SlabCount == 1 ? "slab" : "slabs")</p>
                            <p>Rates from @Fmt.Percent(c.LowestRate) to @Fmt.Percent(c.HighestRate). The top slab starts at an annual income of @Fmt.Amount(c.TopSlabFrom).</p>
                            <div class="setup-tile-meta">
                                <span><i class="bi bi-calendar-range"></i>01/07/@c.StartYear to 30/06/@(c.StartYear + 1)</span>
                                @if (c.HasWarnings)
                                {
                                    <span class="tax-chip-warn"><i class="bi bi-exclamation-triangle"></i>Check slabs</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
