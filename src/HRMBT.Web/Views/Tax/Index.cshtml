@model IEnumerable<HRMBT.Web.Models.TaxRule>

@{
    ViewData["Title"] = "Tax rules";
    var hasFilter = ViewBag.HasTaxYearFilter as bool? == true;
    var selectedYear = ViewBag.SelectedTaxYear as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tax slabs</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold"><i class="bi bi-percent text-primary me-2"></i>Tax slabs</h1>
            <p class="text-muted mb-0 small">
                Maintain income-tax brackets (<code>dbo.TaxRules</code>). Select a tax year to view slabs for that period.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New slab</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border shadow-sm mb-4">
        <div class="card-header bg-light py-2">
            <i class="bi bi-funnel me-1"></i>Tax year
        </div>
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <div class="col-md-6 col-lg-4">
                    <label class="form-label small mb-1" for="taxYear">Tax year</label>
                    <select name="taxYear" id="taxYear" class="form-select" asp-items="ViewBag.TaxYearFilter"
                            onchange="this.form.submit()"></select>
                </div>
                @if (hasFilter)
                {
                    <div class="col-md-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                }
            </form>
            @if (hasFilter)
            {
                <p class="text-muted small mb-0 mt-2">
                    Showing <strong>@Model.Count()</strong> slab(s) for tax year <strong>@selectedYear</strong>.
                </p>
            }
            else
            {
                <p class="text-muted small mb-0 mt-2">Choose a tax year to load slabs in the grid below.</p>
            }
        </div>
    </div>

    <div class="table-responsive border rounded shadow-sm bg-white">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.TaxYear)</th>
                    <th>@Html.DisplayNameFor(model => model.MinSalary)</th>
                    <th>@Html.DisplayNameFor(model => model.MaxSalary)</th>
                    <th>@Html.DisplayNameFor(model => model.TaxPercentage)</th>
                    <th class="text-end" style="width:220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.TaxYear)</td>
                        <td>@Html.DisplayFor(modelItem => item.MinSalary)</td>
                        <td>@Html.DisplayFor(modelItem => item.MaxSalary)</td>
                        <td>@Html.DisplayFor(modelItem => item.TaxPercentage)%</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!hasFilter)
    {
        <div class="alert alert-secondary mt-3 mb-0">
            Select a <strong>tax year</strong> from the dropdown to display tax slabs.
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-info mt-3 mb-0">
            No tax slabs for <strong>@selectedYear</strong>. <a asp-action="Create">Create a slab</a> for this year.
        </div>
    }
</div>
