@model HRMBT.Web.Models.ViewModels.SetupUserFormVm
@{
    ViewData["Title"] = "Edit user";
    var titleName = string.IsNullOrWhiteSpace(Model.Username) ? "Edit user" : $"Edit user ({Model.Username.Trim()})";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
    <style>
        .setup-user-form-compact .card-body { padding: 0.5rem 0.65rem !important; }
        .setup-user-form-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        .setup-user-form-table .pd-label {
            width: 14%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.875rem;
            font-weight: 600;
            color: #000;
            background: #f8fafc;
            border-right: 1px solid #eef0f2;
        }
        .setup-user-form-table .pd-value {
            width: 36%;
            padding: 0.35rem 0.55rem;
            vertical-align: middle;
            font-size: 0.875rem;
            color: #0d6efd;
        }
        .setup-user-form-table .form-control {
            font-size: 0.8125rem;
            min-height: 1.75rem;
            height: 1.75rem;
            padding: 0.15rem 0.4rem;
            color: #0d6efd;
            line-height: 1.25;
        }
        .setup-user-form-table .form-control:focus {
            color: #0a58ca;
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.2);
        }
        .setup-user-form-table .form-text {
            font-size: 0.7rem;
            margin-top: 0.2rem;
            margin-bottom: 0;
        }
        .setup-user-form-table tr { border-bottom: 1px solid #eef0f2; }
        .setup-user-form-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            justify-content: flex-end;
            align-items: center;
            padding: 0.65rem 0.85rem;
        }
        .setup-user-form-compact .grid-card .card-header {
            font-size: 0.9rem;
        }
    </style>
}

<div class="payslip-page setup-user-form-compact py-3">
    <div class="container-fluid px-3 px-lg-4">
        <form asp-action="EditUser" asp-route-id="@Model.Uid" method="post">
            <input type="hidden" asp-for="Uid" />
            <div class="grid-card mb-3">
                <div class="card-header">
                    <span><i class="bi bi-pencil"></i>@titleName</span>
                </div>
                <div class="card-body p-0">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger m-3 mb-0" role="alert">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="payroll-details-table setup-user-form-table mb-0">
                            <tbody>
                                <tr>
                                    <th scope="row" class="pd-label">Username</th>
                                    <td class="pd-value">
                                        <input asp-for="Username" class="form-control" autocomplete="username" />
                                        <span asp-validation-for="Username" class="text-danger small"></span>
                                    </td>
                                    <th scope="row" class="pd-label">Employee ID</th>
                                    <td class="pd-value">
                                        <input asp-for="EmployeeId" class="form-control" />
                                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Role</th>
                                    <td class="pd-value">
                                        <input asp-for="Role" class="form-control" />
                                        <span asp-validation-for="Role" class="text-danger small"></span>
                                    </td>
                                    <th scope="row" class="pd-label">Password</th>
                                    <td class="pd-value">
                                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                        <div class="form-text">Leave blank to keep the current password.</div>
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="pd-label">Confirm password</th>
                                    <td class="pd-value" colspan="3">
                                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="setup-user-form-actions">
                        <button type="submit" class="btn btn-sm btn-grid-edit"><i class="bi bi-check2 me-1"></i>Save</button>
                        <a class="btn btn-sm btn-grid-delete" asp-action="Users">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
