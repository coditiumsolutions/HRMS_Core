@{
    ViewData["Title"] = "Setup";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <style>
        .setup-home {
            max-width: none;
        }
        .setup-home .setup-intro {
            margin-bottom: 1.25rem;
        }
        .setup-home .setup-intro h1 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #00203f;
            margin-bottom: 0.35rem;
        }
        .setup-home .setup-intro p {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 0;
        }
        .setup-tile {
            background: #fff;
            border: 1px solid rgba(0, 32, 63, 0.08);
            border-radius: 0.75rem;
            box-shadow: 0 0.25rem 1rem rgba(0, 32, 63, 0.06);
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        a.setup-tile { text-decoration: none; color: inherit; }
        a.setup-tile:focus-visible { outline: 2px solid #d4af37; outline-offset: 2px; }
        .setup-tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.35rem rgba(0, 32, 63, 0.12);
        }
        .setup-tile-header {
            padding: 0.45rem 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }
        .setup-tile-icon {
            width: 1.9rem;
            height: 1.9rem;
            border-radius: 0.4rem;
            background: rgba(212, 175, 55, 0.2);
            border: 1px solid rgba(240, 215, 140, 0.45);
            color: #f0d78c;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .setup-tile-body {
            padding: 0.6rem 0.85rem 0.7rem; border-left: 3px solid #d4af37;
            display: flex;
            flex-direction: column;
            flex: 1;
        }
        .setup-tile-body p {
            color: #6c757d;
            font-size: 0.875rem;
            line-height: 1.5;
            margin-bottom: 0;
            flex: 1;
        }
        .setup-tile-body code {
            font-size: 0.8em;
            color: #336b87;
            background: #f1f5f8;
            padding: 0.1rem 0.35rem;
            border-radius: 0.25rem;
        }
        .setup-tile-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-bottom: 0.5rem;
        }
        .setup-tile-meta span {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: #495057;
            background: #f8fafc;
            border: 1px solid #e9ecef;
            border-radius: 0.25rem;
            padding: 0.2rem 0.5rem;
        }
        .setup-tile-meta span i {
            color: #d4af37;
            margin-right: 0.25rem;
        }
        .setup-section { margin-bottom: 1.5rem; }
        .setup-section-title {
            font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
            color: #00203f; margin: 0 0 0.6rem; padding-bottom: 0.35rem; border-bottom: 2px solid #d4af37;
        }
        .setup-tile-actions {
            margin-top: auto;
        }
        .setup-tile-actions .btn {
            min-width: 8.5rem;
        }
    </style>
}

<div class="setup-home">
    <div class="setup-intro">
        <h1><i class="bi bi-gear-wide-connected me-2" style="color:#d4af37;"></i>System setup</h1>
        <p>Manage the HR lists, configuration values and login accounts.</p>
    </div>

    <section class="setup-section">
        <h2 class="setup-section-title">HR managed</h2>
        <div class="row g-3">
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-controller="Lookups" asp-action="Index" asp-route-kind="departments">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-building"></i></span>
                        <span>Departments</span>
                    </div>
                    <div class="setup-tile-body">
                        <p>Main departments shared by all projects (Administration, Operations, Security...).</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-controller="Lookups" asp-action="Index" asp-route-kind="subdepartments">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-diagram-2"></i></span>
                        <span>Sub-departments</span>
                    </div>
                    <div class="setup-tile-body">
                        <p>Optional detail under a department, such as Mess under Administration. Information only.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-controller="Lookups" asp-action="Index" asp-route-kind="projects">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                        <span>Projects</span>
                    </div>
                    <div class="setup-tile-body">
                        <p>The HR-managed project list. Add, rename, reorder or deactivate projects; no project name or count is built into the system.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-controller="Lookups" asp-action="Index" asp-route-kind="designations">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-award"></i></span>
                        <span>Designations</span>
                    </div>
                    <div class="setup-tile-body">
                        <p>Job titles with a rank that orders employee lists.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-controller="Lookups" asp-action="Index" asp-route-kind="leavetypes">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-calendar-check"></i></span>
                        <span>Leave types</span>
                    </div>
                    <div class="setup-tile-body">
                        <p>Leave types used by leave requests and quotas, with carry-forward rules.</p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <section class="setup-section">
        <h2 class="setup-section-title">Admin</h2>
        <div class="row g-3">
@if (User.IsInRole("Admin"))
{
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-action="Users">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
                        <span>Users</span>
                    </div>
                    <div class="setup-tile-body">
                        <div class="setup-tile-meta">
                            <span><i class="bi bi-shield-lock"></i>Login accounts</span>
                        </div>
                        <p>Create and maintain login accounts and their roles. Passwords are stored as secure hashes used by the login page.</p>
                    </div>
                </a>
            </div>
}
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-action="FuelPrices">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-fuel-pump"></i></span>
                        <span>Fuel prices</span>
                    </div>
                    <div class="setup-tile-body">
                        <p>The fuel price used by payroll, with the date each price starts from.</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="setup-tile" asp-action="Config">
                    <div class="setup-tile-header">
                        <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-sliders"></i></span>
                        <span>Config</span>
                    </div>
                    <div class="setup-tile-body">
                        <div class="setup-tile-meta">
                            <span><i class="bi bi-key"></i>Key / value</span>
                        </div>
                        <p>View and edit key/value entries that drive lists, payroll settings, and other system options.</p>
                    </div>
                </a>
            </div>
        </div>
    </section>
</div>
