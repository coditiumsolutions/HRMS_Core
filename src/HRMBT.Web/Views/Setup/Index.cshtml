@{
    ViewData["Title"] = "Setup";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <style>
        .setup-home {
            max-width: 960px;
        }
        .setup-home .setup-intro {
            margin-bottom: 1.25rem;
        }
        .setup-home .setup-intro h1 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #00203f;
            margin-bottom: 0.35rem;
        }
        .setup-home .setup-intro p {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 0;
        }
        .setup-tile {
            background: #fff;
            border: 1px solid rgba(0, 32, 63, 0.08);
            border-radius: 0.75rem;
            box-shadow: 0 0.25rem 1rem rgba(0, 32, 63, 0.06);
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .setup-tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.35rem rgba(0, 32, 63, 0.12);
        }
        .setup-tile-header {
            background: linear-gradient(90deg, #336b87 0%, #2a5a73 100%);
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.02em;
            border-bottom: 2px solid #d4af37;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }
        .setup-tile-icon {
            width: 2.35rem;
            height: 2.35rem;
            border-radius: 0.4rem;
            background: rgba(212, 175, 55, 0.2);
            border: 1px solid rgba(240, 215, 140, 0.45);
            color: #f0d78c;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }
        .setup-tile-body {
            padding: 1.15rem 1.15rem 1.25rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }
        .setup-tile-body p {
            color: #6c757d;
            font-size: 0.875rem;
            line-height: 1.5;
            margin-bottom: 1.1rem;
            flex: 1;
        }
        .setup-tile-body code {
            font-size: 0.8em;
            color: #336b87;
            background: #f1f5f8;
            padding: 0.1rem 0.35rem;
            border-radius: 0.25rem;
        }
        .setup-tile-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-bottom: 1rem;
        }
        .setup-tile-meta span {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: #495057;
            background: #f8fafc;
            border: 1px solid #e9ecef;
            border-radius: 0.25rem;
            padding: 0.2rem 0.5rem;
        }
        .setup-tile-meta span i {
            color: #d4af37;
            margin-right: 0.25rem;
        }
        .setup-tile-actions {
            margin-top: auto;
        }
        .setup-tile-actions .btn {
            min-width: 8.5rem;
        }
    </style>
}

<div class="setup-home">
    <div class="setup-intro">
        <h1><i class="bi bi-gear-wide-connected me-2" style="color:#d4af37;"></i>System setup</h1>
        <p>Manage application users (login accounts) and configuration values.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
                    <span>Users</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-shield-lock"></i>Login accounts</span>
                        <span><i class="bi bi-database"></i>dbo.Users</span>
                    </div>
                    <p>Create and maintain login accounts. Passwords are stored as secure hashes used by the login page.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-action="Users">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Open users
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="setup-tile">
                <div class="setup-tile-header">
                    <span class="setup-tile-icon" aria-hidden="true"><i class="bi bi-sliders"></i></span>
                    <span>Config</span>
                </div>
                <div class="setup-tile-body">
                    <div class="setup-tile-meta">
                        <span><i class="bi bi-key"></i>Key / value</span>
                        <span><i class="bi bi-database"></i>dbo.Configuration</span>
                    </div>
                    <p>View and edit key/value entries that drive lists, payroll settings, and other system options.</p>
                    <div class="setup-tile-actions">
                        <a class="btn btn-sm btn-grid-edit" asp-action="Config">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Open config
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
