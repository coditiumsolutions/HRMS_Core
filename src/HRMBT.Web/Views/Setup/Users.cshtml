@model IReadOnlyList<HRMBT.Web.Models.AppUser>
@{
    ViewData["Title"] = "Users";
    var editBaseUrl = Url.Action("EditUser", "Setup", new { id = "__id__" });
    var deleteBaseUrl = Url.Action("DeleteUser", "Setup", new { id = "__id__" });
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-0">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-people"></i>Users</span>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a class="btn btn-sm btn-grid-edit" asp-action="CreateUser"><i class="bi bi-plus-lg me-1"></i>Create user</a>
                </div>
            </div>
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-person-x"></i>
                        <h5 class="mb-1">No users yet</h5>
                        <p class="mb-3">Create one to enable login.</p>
                        <a class="btn btn-sm btn-grid-edit" asp-action="CreateUser"><i class="bi bi-plus-lg me-1"></i>Create user</a>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="setupUsersGrid"
                               data-edit-base="@editBaseUrl">
                            <thead>
                                <tr>
                                    <th>Username</th>
                                    <th>Employee ID</th>
                                    <th>Role</th>
                                    <th>Created</th>
                                    <th class="col-actions text-center" data-align="none" scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model)
                                {
                                    <tr data-record-id="@u.Uid" title="Double-click to open">
                                        <td><div class="emp-name">@u.Username</div></td>
                                        <td>@(u.EmployeeId ?? "—")</td>
                                        <td>@(string.IsNullOrEmpty(u.RoleNames) ? "—" : u.RoleNames)@if (!u.IsActive) { <span class="badge bg-secondary ms-1">disabled</span> }</td>
                                        <td class="text-muted small">@(Fmt.DateAndTime(u.CreatedOn))</td>
                                        <td class="col-actions">
                                            <a class="row-action row-action-edit" asp-controller="Setup" asp-action="EditUser" asp-route-id="@u.Uid" title="Edit user" aria-label="Edit user"><i class="bi bi-pencil-square"></i></a>
                                            <a class="row-action row-action-delete" asp-controller="Setup" asp-action="DeleteUser" asp-route-id="@u.Uid" title="Delete user" aria-label="Delete user"><i class="bi bi-trash3"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
