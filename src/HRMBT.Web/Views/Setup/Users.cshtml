@model IReadOnlyList<HRMBT.Web.Models.AppUser>
@{
    ViewData["Title"] = "Users";
    var editBaseUrl = Url.Action("EditUser", "Setup");
    var deleteBaseUrl = Url.Action("DeleteUser", "Setup");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <div class="page-header-card p-4 mb-4">
            <div class="row align-items-center g-3">
                <div class="col-lg">
                    <h1 class="h2 mb-1 fw-bold text-dark">
                        <i class="bi bi-people text-primary me-2"></i>Users
                    </h1>
                    <p class="text-muted mb-0">Accounts used for application login.</p>
                </div>
                <div class="col-lg-auto">
                    <a class="btn btn-action-primary" asp-action="CreateUser"><i class="bi bi-plus-lg me-1"></i>Create user</a>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Users</span>
                @if (Model != null && Model.Any())
                {
                    <div class="grid-selection-actions">
                        <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-person-x"></i>
                        <h5 class="mb-1">No users yet</h5>
                        <p class="mb-3">Create one to enable login.</p>
                        <a class="btn btn-action-primary" asp-action="CreateUser"><i class="bi bi-plus-lg me-1"></i>Create user</a>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="setupUsersGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>Username</th>
                                    <th>Employee ID</th>
                                    <th>Role</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model)
                                {
                                    <tr data-record-id="@u.Uid" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedUser" value="@u.Uid" aria-label="Select user @u.Username" />
                                        </td>
                                        <td><div class="emp-name">@u.Username</div></td>
                                        <td>@(u.EmployeeId ?? "—")</td>
                                        <td>@(u.Role ?? "—")</td>
                                        <td class="text-muted small">@(u.CreatedOn ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
