@model IReadOnlyList<HRMBT.Web.Models.HrConfiguration>
@{
    ViewData["Title"] = "Configuration";
    var editBaseUrl = Url.Action("EditConfig", "Setup");
    var deleteBaseUrl = Url.Action("DeleteConfig", "Setup");

    static string TrimForTable(string? s, int max = 96)
    {
        if (string.IsNullOrEmpty(s)) return "—";
        if (s.Length <= max) return s;
        return s.Substring(0, max).TrimEnd() + "…";
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <div class="toolbar-card mb-4">
            <div class="toolbar-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="bi bi-gear"></i>Configuration</span>
                <div class="toolbar-actions d-flex flex-wrap gap-2">
                    <a class="btn btn-action-primary" asp-action="CreateConfig">
                        <i class="bi bi-plus-lg me-1"></i>New configuration
                    </a>
                </div>
            </div>
            <div class="p-3 px-lg-4 pb-0">
                <p class="text-muted small mb-0">Rows from <code>dbo.Configuration</code>. Key up to 50 characters; values can be long (comma-separated). Edit or Delete an existing row.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Configuration rows</span>
                @if (Model != null && Model.Any())
                {
                    <div class="grid-selection-actions">
                        <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No configuration rows</h5>
                        <p class="mb-3">Use <strong>New configuration</strong> to add one.</p>
                        <a class="btn btn-action-primary" asp-action="CreateConfig">
                            <i class="bi bi-plus-lg me-1"></i>New configuration
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="setupConfigGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>UID</th>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    var fullVal = c.ConfigValue;
                                    var shortVal = TrimForTable(fullVal);
                                    <tr data-record-id="@c.UID" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedConfig" value="@c.UID" aria-label="Select configuration @c.ConfigKey" />
                                        </td>
                                        <td>@c.UID</td>
                                        <td>@(c.ConfigKey ?? "—")</td>
                                        <td class="small" title="@fullVal">@shortVal</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
