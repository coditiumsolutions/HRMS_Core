@model HRMBT.Web.Models.PaginatedList<HRMBT.Web.Models.Deduction>

@{
    ViewData["Title"] = "Deductions";
    ViewData["Module"] = "Deductions";
    var editBaseUrl = Url.Action("Edit", "Deductions");
    var deleteBaseUrl = Url.Action("Delete", "Deductions");
    var detailsBaseUrl = Url.Action("Details", "Deductions");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Deductions</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap gap-2 justify-content-end mb-4">
            <a asp-action="Add" class="btn btn-action-primary"><i class="bi bi-ui-checks-grid me-1"></i>Bulk add</a>
            <a asp-action="Create" class="btn btn-action-secondary"><i class="bi bi-plus-lg me-1"></i>Single deduction</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card mb-4">
            <div class="card-header"><span><i class="bi bi-funnel"></i>Search &amp; filters</span></div>
            <div class="card-body p-3 p-lg-4">
                <form asp-action="Index" method="get" class="row g-3 align-items-end" onsubmit="document.getElementById('dedPageInput').value = '1';">
                    <input type="hidden" name="page" id="dedPageInput" value="1" />
                    <div class="col-12 col-md">
                        <label class="form-label" for="deptId">Department</label>
                        <select name="deptId" id="deptId" class="form-select" asp-items="ViewBag.DepartmentFilterOptions"
                                onchange="document.getElementById('dedPageInput').value = '1'; this.form.submit();"></select>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="empSearch">Employee ID or name</label>
                        <input type="text" name="empSearch" id="empSearch" class="form-control" value="@ViewBag.CurrentEmpSearch" placeholder="Search…" />
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="isActive">Status</label>
                        <select name="isActive" id="isActive" class="form-select">
                            @{
                                var cur = ViewBag.CurrentIsActive as bool?;
                            }
                            <option value="" selected="@(!cur.HasValue)">All</option>
                            <option value="true" selected="@(cur == true)">Active</option>
                            <option value="false" selected="@(cur == false)">Inactive</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-auto">
                        <label class="form-label" for="pageSize">Page size</label>
                        <select name="pageSize" id="pageSize" class="form-select">
                            @foreach (var ps in ViewBag.PageSizeOptions as IEnumerable<int> ?? new[] { 10, 20, 50, 100 })
                            {
                                var curPs = ViewBag.CurrentPageSize as int? ?? 20;
                                <option value="@ps" selected="@(curPs == ps)">@ps</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-action-primary w-100"><i class="bi bi-funnel-fill me-1"></i>Apply</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Deductions</span>
                @if (Model != null && Model.Any())
                {
                    <div class="grid-selection-actions">
                        <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                    </div>
                }
            </div>
            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <div class="empty-state p-4">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No deductions found</h5>
                        <p class="mb-3">Adjust filters or add a deduction.</p>
                        <a asp-action="Create" class="btn btn-action-primary"><i class="bi bi-plus-lg me-1"></i>Add deduction</a>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="deductionsGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-details-base="@detailsBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>Employee</th>
                                    <th>Type</th>
                                    <th>Name</th>
                                    <th>Frequency</th>
                                    <th>Method</th>
                                    <th class="text-end col-salary">Value</th>
                                    <th>Mandatory</th>
                                    <th>Effective</th>
                                    <th>End</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr data-record-id="@item.Id" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedDeduction" value="@item.Id" aria-label="Select deduction @item.Id" />
                                        </td>
                                        <td>
                                            <div class="emp-name">@(item.Employee?.EmployeeName ?? "—")</div>
                                            <div class="emp-meta">@(item.Employee?.EmployeeID ?? item.EmployeeId.ToString())</div>
                                        </td>
                                        <td>@item.DeductionType</td>
                                        <td>@item.DeductionName</td>
                                        <td>@item.Frequency</td>
                                        <td>@item.CalculationMethod</td>
                                        <td class="text-end salary col-salary">
                                            @if (string.Equals(item.CalculationMethod, "Percentage", StringComparison.OrdinalIgnoreCase))
                                            {
                                                @($"{item.PercentageValue:N2} %")
                                            }
                                            else
                                            {
                                                @($"PKR {item.PercentageValue:N2}")
                                            }
                                        </td>
                                        <td>@(item.IsMandatory ? "Yes" : "No")</td>
                                        <td class="text-nowrap">@item.EffectiveDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-nowrap">@(item.EndDate.HasValue ? item.EndDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="status-pill status-active">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-inactive">No</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Deduction pagination" class="mt-2 px-3 pb-3">
                            <ul class="pagination justify-content-center mb-2">
                                @{
                                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                                    int startPage = Math.Max(1, Model.PageIndex - 2);
                                    int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                    if (endPage - startPage < 4)
                                    {
                                        if (startPage == 1) { endPage = Math.Min(Model.TotalPages, startPage + 4); }
                                        else if (endPage == Model.TotalPages) { startPage = Math.Max(1, endPage - 4); }
                                    }
                                }
                                <li class="page-item @prevDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-isActive="@ViewBag.CurrentIsActive">&laquo;&laquo;</a>
                                </li>
                                <li class="page-item @prevDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-isActive="@ViewBag.CurrentIsActive">&laquo;</a>
                                </li>
                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    var active = i == Model.PageIndex ? "active" : "";
                                    <li class="page-item @active">
                                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@ViewBag.CurrentPageSize"
                                           asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-isActive="@ViewBag.CurrentIsActive">@i</a>
                                    </li>
                                }
                                <li class="page-item @nextDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-isActive="@ViewBag.CurrentIsActive">&raquo;</a>
                                </li>
                                <li class="page-item @nextDisabled">
                                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-deptId="@ViewBag.CurrentDeptId" asp-route-empSearch="@ViewBag.CurrentEmpSearch" asp-route-isActive="@ViewBag.CurrentIsActive">&raquo;&raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
