@model HRMBT.Web.Models.Deduction

@{
    ViewData["Title"] = "Add deduction";
    ViewData["Module"] = "Deductions";
    var employeeCode = ViewBag.EmployeeCode as string ?? "";
    var employeeDisplay = ViewBag.EmployeeDisplayName as string ?? "";
    var hasEmployee = Model.EmployeeId > 0 && !string.IsNullOrWhiteSpace(employeeDisplay);
    var findUrl = Url.Action("FindEmployee", "Deductions");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
    <style>
        .deduction-create-table .pd-label {
            width: 14%;
            padding: 0.35rem 0.55rem;
            font-size: 0.8125rem;
        }
        .deduction-create-table .pd-value {
            width: 36%;
            padding: 0.35rem 0.55rem;
            font-size: 0.8125rem;
            color: #0d6efd;
        }
        .deduction-create-table .form-control,
        .deduction-create-table .form-select {
            font-size: 0.8125rem;
            min-height: 1.75rem;
            height: 1.75rem;
            padding: 0.15rem 0.4rem;
            color: #0d6efd;
            line-height: 1.25;
        }
        .deduction-create-table .form-control::placeholder {
            color: #8bb7f7;
        }
        .deduction-create-table .form-control:focus,
        .deduction-create-table .form-select:focus {
            color: #0a58ca;
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.2);
        }
        .deduction-create-table .form-control[readonly] {
            background-color: #f8fafc;
            color: #0d6efd;
        }
        .deduction-create-table .form-check {
            margin: 0;
            min-height: auto;
            padding-top: 0;
            padding-bottom: 0;
        }
        .deduction-create-table .form-check-label {
            font-size: 0.8125rem;
            color: #0d6efd;
        }
        .deduction-create-table .form-text {
            font-size: 0.7rem;
            margin-top: 0.1rem;
            color: #6c757d;
        }
        .deduction-create-table tr {
            border-bottom: 1px solid #eef0f2;
        }
        .deduction-create-table tr[data-employee-lookup] {
            border-bottom: 2px solid #00203f;
        }
        .deduction-create-table tr[data-employee-lookup] td,
        .deduction-create-table tr[data-employee-lookup] th {
            padding-bottom: 0.65rem;
        }
        .employee-find-row {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 0.4rem;
        }
        .employee-find-row #employeeCode {
            flex: 1 1 auto;
            min-width: 0;
            max-width: 12rem;
        }
        #btnFindEmployee {
            border-radius: 0.25rem !important;
            padding: 0.2rem 0.75rem !important;
            min-height: 1.75rem;
            height: 1.75rem;
            line-height: 1.2;
            font-size: 0.8125rem;
            font-weight: 600;
            white-space: nowrap;
            flex: 0 0 auto;
        }
        #employeeLookupStatus {
            font-size: 0.75rem;
            line-height: 1.2;
            margin-top: 0.25rem;
        }
        #employeeLookupStatus.ok { color: #198754; }
        #employeeLookupStatus.err { color: #dc3545; }
        #deductionFormFields.is-locked tbody tr:not([data-employee-lookup]) {
            opacity: 0.55;
            pointer-events: none;
        }
        .deduction-create-actions {
            padding: 0.65rem 0.85rem !important;
        }
    </style>
}

<div class="payslip-page py-4">
    <div class="container-fluid px-3 px-lg-4">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Deductions</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add</li>
            </ol>
        </nav>

        <div class="grid-card mb-3">
            <div class="card-header"><span><i class="bi bi-plus-lg"></i>Add deduction</span></div>
            <div class="card-body p-0">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 m-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger m-3 mb-0" role="alert">
                        <div class="fw-semibold mb-1">Please fix the following before saving:</div>
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Create" method="post" id="deductionCreateForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EmployeeId" id="EmployeeId" />

                    <div id="deductionFormFields" class="@(hasEmployee ? "" : "is-locked")">
                        <div class="table-responsive">
                            <table class="payroll-details-table deduction-create-table mb-0">
                                <tbody>
                                    <tr data-employee-lookup>
                                        <th scope="row" class="pd-label">Employee ID</th>
                                        <td class="pd-value">
                                            <div class="employee-find-row">
                                                <input type="text" name="employeeCode" id="employeeCode" class="form-control"
                                                       value="@employeeCode" placeholder="Enter Employee ID…" autocomplete="off" />
                                                <button type="button" class="btn btn-sm btn-action-primary" id="btnFindEmployee">
                                                    <i class="bi bi-search me-1"></i>Find
                                                </button>
                                            </div>
                                            <span id="employeeLookupStatus" class="d-block @(hasEmployee ? "ok" : "")">
                                                @(hasEmployee ? "Employee found." : "Enter Employee ID and click Find.")
                                            </span>
                                            <span asp-validation-for="EmployeeId" class="text-danger"></span>
                                        </td>
                                        <th scope="row" class="pd-label">Employee</th>
                                        <td class="pd-value">
                                            <input type="text" id="employeeFoundName" class="form-control" readonly
                                                   value="@employeeDisplay" placeholder="Name appears after Find" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="pd-label">Deduction type</th>
                                        <td class="pd-value">
                                            <select asp-for="DeductionType" class="form-select" asp-items="ViewBag.DeductionType"></select>
                                            <span asp-validation-for="DeductionType" class="text-danger"></span>
                                        </td>
                                        <th scope="row" class="pd-label">Frequency</th>
                                        <td class="pd-value">
                                            <select asp-for="Frequency" class="form-select" asp-items="ViewBag.Frequency"></select>
                                            <span asp-validation-for="Frequency" class="text-danger"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="pd-label">Deduction name</th>
                                        <td class="pd-value">
                                            <input asp-for="DeductionName" class="form-control" maxlength="100" />
                                            <span asp-validation-for="DeductionName" class="text-danger"></span>
                                        </td>
                                        <th scope="row" class="pd-label">Calculation</th>
                                        <td class="pd-value">
                                            <select asp-for="CalculationMethod" class="form-select" asp-items="ViewBag.CalculationMethod" id="calcMethod"></select>
                                            <span asp-validation-for="CalculationMethod" class="text-danger"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="pd-label"><span id="valueLabel">Value</span></th>
                                        <td class="pd-value">
                                            <input asp-for="PercentageValue" class="form-control" type="number" step="0.01" min="0" id="valueInput" />
                                            <div class="form-text mb-0" id="valueHint"></div>
                                            <span asp-validation-for="PercentageValue" class="text-danger"></span>
                                        </td>
                                        <th scope="row" class="pd-label">Effective date</th>
                                        <td class="pd-value">
                                            <input asp-for="EffectiveDate" class="form-control" type="date" />
                                            <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="pd-label">End date</th>
                                        <td class="pd-value">
                                            <input asp-for="EndDate" class="form-control" type="date" />
                                            <span asp-validation-for="EndDate" class="text-danger"></span>
                                        </td>
                                        <th scope="row" class="pd-label">Mandatory</th>
                                        <td class="pd-value">
                                            <div class="form-check">
                                                <input asp-for="IsMandatory" class="form-check-input" />
                                                <label asp-for="IsMandatory" class="form-check-label"></label>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="pd-label">Active</th>
                                        <td class="pd-value">
                                            <div class="form-check">
                                                <input asp-for="IsActive" class="form-check-input" />
                                                <label asp-for="IsActive" class="form-check-label"></label>
                                            </div>
                                        </td>
                                        <th scope="row" class="pd-label"></th>
                                        <td class="pd-value"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-end deduction-create-actions">
                        <a asp-action="Index" class="btn btn-sm btn-action-secondary">Cancel</a>
                        <button type="submit" class="btn btn-sm btn-action-primary" id="btnSaveDeduction" @(hasEmployee ? null : "disabled")>
                            <i class="bi bi-check2 me-1"></i>Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            var findUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(findUrl ?? "/Deductions/FindEmployee"));
            var codeInput = document.getElementById('employeeCode');
            var uidInput = document.getElementById('EmployeeId');
            var statusEl = document.getElementById('employeeLookupStatus');
            var foundName = document.getElementById('employeeFoundName');
            var fields = document.getElementById('deductionFormFields');
            var saveBtn = document.getElementById('btnSaveDeduction');
            var findBtn = document.getElementById('btnFindEmployee');
            var form = document.getElementById('deductionCreateForm');

            function setLocked(locked) {
                if (fields) fields.classList.toggle('is-locked', locked);
                if (saveBtn) saveBtn.disabled = locked;
            }

            function clearEmployee() {
                if (uidInput) uidInput.value = '0';
                if (foundName) foundName.value = '';
                setLocked(true);
            }

            function setStatus(msg, ok) {
                if (!statusEl) return;
                statusEl.textContent = msg || '';
                statusEl.classList.toggle('ok', !!ok);
                statusEl.classList.toggle('err', !ok && !!msg);
            }

            function applyEmployee(data) {
                if (uidInput) uidInput.value = data.uid;
                if (foundName) foundName.value = data.display || (data.name + ' (' + data.employeeId + ')');
                if (codeInput && data.employeeId) codeInput.value = data.employeeId;
                setStatus('Employee found.', true);
                setLocked(false);
            }

            function findEmployee() {
                var q = (codeInput && codeInput.value || '').trim();
                if (!q) {
                    clearEmployee();
                    setStatus('Enter an Employee ID.', false);
                    return;
                }
                setStatus('Searching…', true);
                fetch(findUrl + '?q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.found) {
                            applyEmployee(data);
                        } else {
                            clearEmployee();
                            setStatus((data && data.message) || 'Employee not found.', false);
                        }
                    })
                    .catch(function () {
                        clearEmployee();
                        setStatus('Lookup failed. Try again.', false);
                    });
            }

            if (findBtn) findBtn.addEventListener('click', findEmployee);
            if (codeInput) {
                codeInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        findEmployee();
                    }
                });
                codeInput.addEventListener('input', function () {
                    clearEmployee();
                    setStatus('Enter Employee ID and click Find.', false);
                });
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    var uid = parseInt(uidInput && uidInput.value ? uidInput.value : '0', 10);
                    if (!uid || uid <= 0) {
                        e.preventDefault();
                        setStatus('Find a valid employee before saving.', false);
                        if (codeInput) codeInput.focus();
                    }
                });
            }

            var calc = document.getElementById('calcMethod');
            var label = document.getElementById('valueLabel');
            var hint = document.getElementById('valueHint');
            var input = document.getElementById('valueInput');
            function sync() {
                if (!calc || !label || !hint || !input) return;
                var m = (calc.value || '').toLowerCase();
                if (m === 'percentage') {
                    label.textContent = 'Percentage';
                    hint.textContent = '0–100 % of gross (basic + allowances).';
                    input.max = '100';
                } else {
                    label.textContent = 'Fixed amount (PKR)';
                    hint.textContent = 'Fixed PKR amount stored in PercentageValue.';
                    input.removeAttribute('max');
                }
            }
            if (calc) {
                calc.addEventListener('change', sync);
                sync();
            }

            @if (hasEmployee)
            {
                <text>setLocked(false);</text>
            }
        })();
    </script>
}
