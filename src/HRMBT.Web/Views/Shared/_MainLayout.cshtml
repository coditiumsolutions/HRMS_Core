@{
    var authName = User.Identity?.IsAuthenticated == true ? User.Identity!.Name : null;
    var displayName = User.FindFirst(AuthClaims.DisplayName)?.Value ?? authName;
    var loginAt = User.FindFirst(AuthClaims.LoginAt)?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HRMBT.Web.styles.css" asp-append-version="true" />
    <style>
        .navbar-top-1 {
            background-color: white;
            border-bottom: 3px solid #336B87;
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            min-height: auto;
        }
        .navbar-top-1 .navbar-brand {
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            font-size: 1rem;
        }
        .navbar-top-1 .navbar-text {
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            color: #0d6efd;
        }
        .navbar-top-2 {
            background-color: #00203F;
        }
        .navbar-top-2 .nav-link {
            color: white !important;
        }
        .navbar-top-2 .navbar-nav.ms-auto .nav-link {
            font-size: 0.95rem;
        }
        .navbar-top-2 .navbar-modules-nav .nav-link {
            font-weight: 400 !important;
            font-size: 0.95rem;
        }
        .navbar-top-2 .dropdown-toggle::after {
            margin-left: 0.4em;
            vertical-align: 0.15em;
            border-top-color: #D4AF37;
        }
        .navbar-top-2 .dropdown-menu {
            background-color: #0b2d52;
            border: 1px solid rgba(212, 175, 55, 0.4);
            border-radius: 0.4rem;
            padding: 0.35rem 0;
            min-width: 11rem;
            box-shadow: 0 0.5rem 1.25rem rgba(0, 32, 63, 0.35);
        }
        .navbar-top-2 .dropdown-item {
            color: #fff;
            font-size: 0.95rem;
            font-weight: 400;
            padding: 0.45rem 1rem;
        }
        .navbar-top-2 .dropdown-item:hover,
        .navbar-top-2 .dropdown-item:focus {
            background-color: #336b87;
            color: #fff;
        }
        .navbar-top-2 .dropdown-item.active {
            background-color: #336b87;
            color: #D4AF37;
        }
        @@media (min-width: 576px) {
            .navbar-top-2 .navbar-modules-nav .nav-link {
                padding-left: 1.35rem;
                padding-right: 1.35rem;
            }
            .navbar-top-2 .navbar-nav.ms-auto .nav-link {
                padding-left: 1.35rem;
                padding-right: 1.35rem;
            }
            .navbar-top-2 .navbar-modules-nav .nav-item + .nav-item,
            .navbar-top-2 .navbar-nav.ms-auto .nav-item {
                position: relative;
            }
            .navbar-top-2 .navbar-modules-nav .nav-item + .nav-item::before,
            .navbar-top-2 .navbar-nav.ms-auto .nav-item::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 2px;
                height: 0.75rem;
                background-color: #D4AF37;
                border-radius: 1px;
            }
        }
        .sidebar {
            background-color: #00203F;
            min-height: calc(100vh - 120px);
            padding: 20px 10px;
            border-right: 1px solid #dee2e6;
            margin-bottom: 0;
        }
        .sidebar h5 {
            color: white;
            font-size: 1rem;
        }
        .sidebar .nav-link {
            color: white !important;
            padding: 0.55rem 0.5rem;
            margin-bottom: 0.45rem;
            border-radius: 4px;
            font-size: 0.875rem;
            border-bottom: 1px solid #D4AF37;
        }
        .sidebar hr {
            border-color: #D4AF37 !important;
            opacity: 1;
        }
        .sidebar .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.2);
            color: white !important;
        }
        .sidebar .text-muted {
            color: rgba(255, 255, 255, 0.7) !important;
        }
        .main-content {
            padding: 20px;
            margin-bottom: 0;
        }
        .container-fluid .row {
            margin-bottom: 0;
        }
        .main-content h1 {
            font-size: 1.75rem;
        }
        .main-content h2 {
            font-size: 1.5rem;
        }
        .main-content h3 {
            font-size: 1.25rem;
        }
        .main-content h4 {
            font-size: 1.1rem;
        }
        .site-footer {
            background-color: #f8f9fa;
            border-top: 2px solid #336B87;
            padding: 0.65rem 1rem;
            color: #6c757d;
            font-size: 0.8rem;
        }
        .site-footer .footer-inner {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem 1rem;
        }
        .site-footer .footer-left,
        .site-footer .footer-center,
        .site-footer .footer-right {
            margin: 0;
            line-height: 1.35;
        }
        .site-footer .footer-center {
            text-align: center;
            color: #00203f;
            font-weight: 600;
        }
        .site-footer .footer-right {
            text-align: right;
        }
        @@media (max-width: 767.98px) {
            .site-footer .footer-inner {
                flex-direction: column;
                text-align: center;
            }
            .site-footer .footer-right {
                text-align: center;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Navigation Bar 2 (Dark Blue) -->
    <nav class="navbar navbar-expand-sm navbar-top-2">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#moduleNavbar" aria-controls="moduleNavbar"
                    aria-expanded="false" aria-label="Toggle navigation" style="border-color: white;">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="moduleNavbar">
                <ul class="navbar-nav navbar-modules-nav flex-grow-1 flex-wrap me-sm-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Employee" asp-action="Index">Employees</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Payroll" asp-action="Index">Payroll</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="LMS" asp-action="Index">LMS</a>
                    </li>
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        var modulesActive = new[] { "Allowances", "Deductions", "Attendance", "Tax", "Setup" }
                            .Contains(currentController, StringComparer.OrdinalIgnoreCase);
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(modulesActive ? "active" : null)"
                           href="#" id="modulesDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            Modules
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="modulesDropdown">
                            <li>
                                <a class="dropdown-item @(string.Equals(currentController, "Allowances", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                   asp-area="" asp-controller="Allowances" asp-action="Index">Allowances</a>
                            </li>
                            <li>
                                <a class="dropdown-item @(string.Equals(currentController, "Deductions", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                   asp-area="" asp-controller="Deductions" asp-action="Index">Deductions</a>
                            </li>
                            <li>
                                <a class="dropdown-item @(string.Equals(currentController, "Attendance", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                   asp-area="" asp-controller="Attendance" asp-action="Index">Attendance</a>
                            </li>
                            <li>
                                <a class="dropdown-item @(string.Equals(currentController, "Tax", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                   asp-area="" asp-controller="Tax" asp-action="Index">Tax</a>
                            </li>
                            <li>
                                <a class="dropdown-item @(string.Equals(currentController, "Setup", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                   asp-area="" asp-controller="Setup" asp-action="Index">Setup</a>
                            </li>
                        </ul>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (string.IsNullOrEmpty(authName))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Login">Login</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Logout">Logout</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Top Navigation Bar 1 (White) -->
    <nav class="navbar navbar-expand-sm navbar-top-1">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HR Management System</a>
            <div class="navbar-nav ms-auto">
                @if (!string.IsNullOrEmpty(authName) && !string.IsNullOrEmpty(loginAt))
                {
                    <span class="navbar-text"><span class="fw-semibold">@(displayName ?? authName)</span> · logged in at @loginAt</span>
                }
                else if (!string.IsNullOrEmpty(authName))
                {
                    <span class="navbar-text"><span class="fw-semibold">@(displayName ?? authName)</span></span>
                }
            </div>
        </div>
    </nav>

    <!-- Main Content Area with Sidebar -->
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar (20% width) -->
            <div class="col-2 sidebar">
                @if (ViewData["Module"]?.ToString() == "Payroll")
                {
                    @await Html.PartialAsync("_PayrollSidebar")
                }
                else if (ViewData["Module"]?.ToString() == "Attendance")
                {
                    @await Html.PartialAsync("_AttendanceSidebar")
                }
                else if (ViewData["Module"]?.ToString() == "Deductions")
                {
                    @await Html.PartialAsync("_DeductionsSidebar")
                }
                else
                {
                    @await Html.PartialAsync("_Sidebar")
                }
            </div>
            
            <!-- Main Content (80% width) -->
            <div class="col-10 main-content">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <footer class="site-footer">
        <div class="footer-inner">
            <p class="footer-left">&copy; 2026. All Rights Reserved.</p>
            <p class="footer-center">HR Management System | Internal Use Only</p>
            <p class="footer-right">Developed &amp; Maintained by IT Department</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


