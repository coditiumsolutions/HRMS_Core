<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HR Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body.login-body {
            min-height: 100vh;
            background:
                radial-gradient(900px 500px at 85% -10%, rgba(217, 184, 76, .16), transparent 60%),
                radial-gradient(700px 480px at -10% 110%, rgba(45, 106, 135, .45), transparent 60%),
                linear-gradient(165deg, #08172f 0%, #0b1f3f 55%, #12305e 100%);
            display: flex; align-items: center; justify-content: center;
            padding: 2rem 1rem;
        }
        .login-panel { max-width: 420px; width: 100%; margin: 0; }
        .login-brand { text-align: center; color: #fff; margin-bottom: 1.5rem; }
        .login-brand h1 { color: #fff; font-size: 1.75rem; margin: 0; }
        .login-brand h1::after { content: ''; display: block; width: 3rem; height: 2px; background: #d9b84c; margin: .8rem auto 0; }
        .login-brand .sub { color: rgba(255,255,255,.65); font-size: .85rem; margin-top: .7rem; letter-spacing: .04em; }
        .login-card { border: 0; border-radius: 14px; box-shadow: 0 24px 48px rgba(0, 0, 0, .35); overflow: hidden; }
        .login-card .card-header { background: #faf8f3 !important; color: #0b1f3f; border-bottom: 1px solid #e4dfd2; font-weight: 600; letter-spacing: .02em; }
        .login-card .btn-primary { width: 100%; padding: .65rem; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/hrms-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="login-body">
    <div class="container login-panel">
        <div class="login-brand">
            <h1>HR Management System</h1>
            <div class="sub">Sign in to continue</div>
        </div>
        <div class="card login-card">
            <div class="card-header py-3">@ViewData["Title"]</div>
            <div class="card-body p-4">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
