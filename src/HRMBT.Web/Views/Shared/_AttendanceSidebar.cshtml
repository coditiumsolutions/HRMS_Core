@{
    // Order: look things up, then enter data, then off days.
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string C(string action) =>
        currentAction == action ? "nav-link active fw-bold text-primary" : "nav-link text-dark";
}

<strong class="sidebar-title">Attendance</strong>
<hr style="border-color: #D4AF37;" />
<ul class="nav flex-column">
    <li class="nav-item">
        <a class="@C("Index")" asp-controller="Attendance" asp-action="Index"><i class="bi bi-calendar-day me-2" aria-hidden="true"></i>Today</a>
    </li>
    <li class="nav-item">
        <a class="@C("AttendanceByDepartment")" asp-controller="Attendance" asp-action="AttendanceByDepartment"><i class="bi bi-building me-2" aria-hidden="true"></i>By Department</a>
    </li>
    <li class="nav-item">
        <a class="@C("MonthlyReport")" asp-controller="Attendance" asp-action="MonthlyReport"><i class="bi bi-calendar-month me-2" aria-hidden="true"></i>Monthly Report</a>
    </li>
    <li class="nav-item">
        <a class="@C("Create")" asp-controller="Attendance" asp-action="Create"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Attendance</a>
    </li>
    <li class="nav-item">
        <a class="@C("Upload")" asp-controller="Attendance" asp-action="Upload"><i class="bi bi-upload me-2" aria-hidden="true"></i>Upload File</a>
    </li>
    <li class="nav-item">
        <a class="@C("OffDay")" asp-controller="Attendance" asp-action="OffDay"><i class="bi bi-umbrella me-2" aria-hidden="true"></i>Off Days</a>
    </li>
    <li class="nav-item">
        <a class="@C("WorkWeeks")" asp-controller="EmployeeSchedule" asp-action="WorkWeeks"><i class="bi bi-calendar-week me-2" aria-hidden="true"></i>Work Weeks</a>
    </li>
</ul>
