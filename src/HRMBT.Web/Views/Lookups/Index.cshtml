@model HRMBT.Web.Models.ViewModels.LookupListVm
@{
    ViewData["Title"] = Model.Title;
    var tabs = new (string Kind, string Label)[]
    {
        ("departments", "Departments"), ("subdepartments", "Sub-departments"), ("projects", "Projects"),
        ("designations", "Designations"), ("leavetypes", "Leave types")
    };
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-0">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <ul class="nav nav-pills lookup-tabs mb-3 gap-1 flex-wrap">
            @foreach (var t in tabs)
            {
                <li class="nav-item">
                    <a class="nav-link @(t.Kind == Model.Kind ? "active" : "")" asp-action="Index" asp-route-kind="@t.Kind">@t.Label</a>
                </li>
            }
        </ul>

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-list-ul"></i>@Model.Title <span class="text-muted small ms-1">(@Model.Rows.Count)</span></span>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (Model.Kind == "subdepartments")
                    {
                        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 mb-0">
                            <input type="hidden" name="kind" value="subdepartments" />
                            <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Filter by department">
                                <option value="">All departments</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.Id" selected="@(Model.DepartmentFilterId == d.Id)">@d.Name</option>
                                }
                            </select>
                        </form>
                    }
                    <a class="btn btn-sm btn-grid-edit" asp-action="Create" asp-route-kind="@Model.Kind" asp-route-departmentId="@Model.DepartmentFilterId"><i class="bi bi-plus-lg me-1"></i>Add</a>
                </div>
            </div>
            <div class="card-body">
                <p class="grid-note">@Model.Description</p>

                @if (!Model.Rows.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <h5 class="mb-1">Nothing here yet</h5>
                        <p class="mb-3">Add the first entry.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>@Model.DetailHeader</th>
                                    <th class="text-end">@Model.SortHeader</th>
                                    <th>Status</th>
                                    <th class="text-end">@Model.UsageHeader</th>
                                    <th class="col-actions col-actions--3 text-center" data-align="none" scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Rows)
                                {
                                    <tr class="@(r.IsActive ? "" : "text-muted")">
                                        <td><div class="emp-name">@r.Name</div></td>
                                        <td>@r.Detail</td>
                                        <td class="text-end">@r.SortOrder</td>
                                        <td>
                                            @if (r.IsActive) { <span class="badge bg-success">Active</span> }
                                            else { <span class="badge bg-secondary">Inactive</span> }
                                        </td>
                                        <td class="text-end">@r.Usage</td>
                                        <td class="col-actions col-actions--3">
                                            <a class="row-action row-action-edit" asp-action="Edit" asp-route-kind="@Model.Kind" asp-route-id="@r.Id" title="Edit" aria-label="Edit"><i class="bi bi-pencil-square"></i></a>
                                            <form asp-action="Toggle" asp-route-kind="@Model.Kind" asp-route-id="@r.Id" method="post">
                                                <input type="hidden" name="kind" value="@Model.Kind" />
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <input type="hidden" name="departmentId" value="@Model.DepartmentFilterId" />
                                                <button type="submit" class="row-action row-action-edit" title="@(r.IsActive ? "Deactivate" : "Activate")" aria-label="@(r.IsActive ? "Deactivate" : "Activate")"><i class="bi @(r.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i></button>
                                            </form>
                                            @if (r.Usage == 0)
                                            {
                                                <form asp-action="Delete" asp-route-kind="@Model.Kind" asp-route-id="@r.Id" method="post"  onsubmit="return confirm('Delete @(r.Name.Replace("'", "")) permanently?');">
                                                    <input type="hidden" name="kind" value="@Model.Kind" />
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <input type="hidden" name="departmentId" value="@Model.DepartmentFilterId" />
                                                    <button type="submit" class="row-action row-action-delete" title="Delete" aria-label="Delete"><i class="bi bi-trash3"></i></button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="grid-note grid-note--foot">An entry that is in use cannot be deleted. Deactivate it to hide it from new entries; existing records keep it.</p>
                }
            </div>
        </div>
    </div>
</div>
