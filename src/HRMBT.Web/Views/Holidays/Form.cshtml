@model HRMBT.Web.Models.ViewModels.HolidayFormVm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add holiday" : "Edit holiday";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-0">
        <partial name="_Alerts" />
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id.ToString())" method="post">
            <div class="grid-card mb-3">
                <div class="card-header"><span><i class="bi bi-calendar-event"></i>@ViewData["Title"]</span></div>
                <div class="card-body grid-form">
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="For example Eid-ul-Fitr" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="From" class="form-label"></label>
                            <input asp-for="From" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="To" class="form-label"></label>
                            <input asp-for="To" class="form-control" />
                            <div class="form-text">Leave empty for one day.</div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NoticeNumber" class="form-label"></label>
                            <input asp-for="NoticeNumber" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NoticeDate" class="form-label"></label>
                            <input asp-for="NoticeDate" class="form-control" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsOptional" class="form-check-input" />
                                <label asp-for="IsOptional" class="form-check-label"></label>
                                <div class="form-text">Employees may work it: it stays a work day, and leave on it is charged.</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="action-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                    <div class="action-bar-hint me-auto d-none d-md-block">Saving recounts open leave on these dates.</div>
                    <a asp-action="Index" class="btn btn-action-secondary">Cancel</a>
                    <button type="submit" class="btn btn-action-primary"><i class="bi bi-check2 me-1"></i>Save holiday</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
