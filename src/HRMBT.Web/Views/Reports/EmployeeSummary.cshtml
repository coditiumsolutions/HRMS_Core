@model HRMBT.Web.Models.ViewModels.EmployeeSummaryVm

@{
    ViewData["Title"] = "Employee Summary";
    ViewData["Module"] = "Reports";
    var selectedDept = ViewBag.SelectedDepartment as string ?? Model.Department;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <style>
        .emp-summary-meta {
            font-size: 0.8rem;
            color: #6c757d;
        }
        .employee-list-page .emp-summary-grid tbody td {
            color: #000;
        }
        .employee-list-page .emp-summary-grid tbody td.num {
            color: #0d6efd;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            text-align: end;
        }
        .employee-list-page .emp-summary-grid tfoot td {
            font-weight: 700;
            border-top: 2px solid #00203f;
            background: #f4f8fb;
        }
        .employee-list-page .emp-summary-grid tfoot td.num {
            color: #0a58ca;
        }
    </style>
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-3 px-lg-4">
        <div class="filter-card filter-card-compact mb-3">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Employee Summary filters</span>
            </div>
            <div class="card-body p-2 p-lg-3">
                <form asp-action="EmployeeSummary" method="get">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-5">
                            <select name="department" id="department" class="form-select form-select-sm" aria-label="Department">
                                <option value="">All Departments</option>
                                @if (ViewBag.Departments != null)
                                {
                                    foreach (var dept in ViewBag.Departments)
                                    {
                                        var deptSelected = selectedDept != null
                                            && string.Equals(selectedDept.ToString(), dept.ToString(), StringComparison.OrdinalIgnoreCase);
                                        <option value="@dept" selected="@deptSelected">@dept</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-auto">
                            <button type="submit" class="btn btn-sm btn-filter-apply">
                                <i class="bi bi-funnel-fill me-1"></i>Apply
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-3">
            <div class="card-header">
                <span><i class="bi bi-people"></i>Employee Summary</span>
            </div>
            <div class="card-body">
                @if (Model.Rows.Count == 0)
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No employees found</h5>
                        <p class="mb-0">No employee departments match the selected filter.</p>
                    </div>
                }
                else
                {
                    <p class="emp-summary-meta px-3 pt-3 mb-2">
                        @if (!string.IsNullOrWhiteSpace(Model.Department))
                        {
                            <text>Department: <strong>@Model.Department</strong></text>
                        }
                        else
                        {
                            <text>All departments</text>
                        }
                        · <strong>@Model.TotalEmployees</strong> employee(s)
                    </p>
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid emp-summary-grid mb-0">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th class="text-end">Total Employees</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Rows)
                                {
                                    <tr>
                                        <td>@row.Department</td>
                                        <td class="num">@row.EmployeeCount</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Total</td>
                                    <td class="num">@Model.TotalEmployees</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
