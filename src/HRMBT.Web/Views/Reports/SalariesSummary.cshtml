@model HRMBT.Web.Models.ViewModels.SalariesSummaryVm
@using HRMBT.Web.Infrastructure

@{
    ViewData["Title"] = "Payroll Summary";
    ViewData["Module"] = "Reports";
    var selectedMonth = Model.Month;
    var selectedYear = Model.Year;
    var yearNow = DateTime.Now.Year;
    var yearMin = yearNow - 10;
    if (selectedYear.HasValue && selectedYear.Value < yearMin)
        yearMin = selectedYear.Value;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
    <style>
        .payroll-summary-totals {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            max-width: 24rem;
        }
        .payroll-summary-tile {
            background: #fff;
            border: 1px solid rgba(0, 32, 63, 0.08);
            border-radius: 0.35rem;
            border-left: 3px solid #d4af37;
            padding: 0.4rem 0.75rem;
            box-shadow: 0 0.1rem 0.35rem rgba(0, 32, 63, 0.04);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }
        .payroll-summary-tile .label {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: #495057;
            margin: 0;
        }
        .payroll-summary-tile .value {
            font-size: 0.95rem;
            font-weight: 700;
            color: #0d6efd;
            font-variant-numeric: tabular-nums;
            margin: 0;
            text-align: right;
        }
        .payroll-summary-tile.is-gross {
            border-left-color: #336b87;
            background: #f4f8fb;
        }
        .payroll-summary-tile.is-gross .value {
            color: #0a58ca;
        }
        .payroll-summary-divider {
            border: 0;
            border-top: 2px solid #00203f;
            margin: 0.2rem 0;
            opacity: 1;
        }
        .payroll-summary-meta {
            font-size: 0.8rem;
            color: #6c757d;
        }
    </style>
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-3 px-lg-4">
        <div class="filter-card filter-card-compact mb-3">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Payroll Summary filters</span>
            </div>
            <div class="card-body p-2 p-lg-3">
                <form asp-action="SalariesSummary" method="get">
                    <div class="row g-2 align-items-center">
                        <div class="col-6 col-md-3">
                            <select name="month" id="month" class="form-select form-select-sm" aria-label="Month" required>
                                <option value="">— Month —</option>
                                @foreach (var monthName in PayrollMonthHelper.AllMonthNames)
                                {
                                    <option value="@monthName" selected="@(string.Equals(selectedMonth, monthName, StringComparison.OrdinalIgnoreCase))">@monthName</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <select name="year" id="year" class="form-select form-select-sm" aria-label="Year" required>
                                <option value="">— Year —</option>
                                @for (int y = yearNow + 1; y >= yearMin; y--)
                                {
                                    <option value="@y" selected="@(selectedYear == y)">@y</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <select name="department" id="department" class="form-select form-select-sm" aria-label="Department">
                                <option value="">All Departments</option>
                                @if (ViewBag.Departments != null)
                                {
                                    foreach (var dept in ViewBag.Departments)
                                    {
                                        var deptSelected = ViewBag.SelectedDepartment != null && ViewBag.SelectedDepartment.ToString() == dept.ToString();
                                        <option value="@dept" selected="@deptSelected">@dept</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-auto">
                            <button type="submit" class="btn btn-sm btn-filter-apply">
                                <i class="bi bi-funnel-fill me-1"></i>Apply
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-3">
            <div class="card-header">
                <span><i class="bi bi-cash-stack"></i>Payroll Summary</span>
            </div>
            <div class="card-body p-3 p-lg-4">
                @if (!Model.HasFilters)
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-funnel"></i>
                        <h5 class="mb-1">Select Month and Year</h5>
                        <p class="mb-0">Choose Month and Year (optional Department), then click Apply to load generated payroll totals.</p>
                    </div>
                }
                else if (Model.PayslipCount == 0)
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No payroll records found</h5>
                        <p class="mb-0">
                            No generated payslips for
                            <strong>@Model.Month @Model.Year</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.Department))
                            {
                                <text> · @Model.Department</text>
                            }
                            .
                        </p>
                    </div>
                }
                else
                {
                    <p class="payroll-summary-meta mb-3">
                        Totals from <strong>@Model.PayslipCount</strong> generated payslip(s)
                        for <strong>@Model.Month @Model.Year</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.Department))
                        {
                            <text> · Department: <strong>@Model.Department</strong></text>
                        }
                        else
                        {
                            <text> · All departments</text>
                        }
                    </p>
                    <div class="payroll-summary-totals">
                        <div class="payroll-summary-tile">
                            <div class="label">Basic Salary</div>
                            <p class="value">@Model.TotalBasicSalary.ToString("N2")</p>
                        </div>
                        <div class="payroll-summary-tile">
                            <div class="label">Allowances</div>
                            <p class="value">@Model.TotalAllowances.ToString("N2")</p>
                        </div>
                        <div class="payroll-summary-tile">
                            <div class="label">Deductions</div>
                            <p class="value">@Model.TotalDeductions.ToString("N2")</p>
                        </div>
                        <hr class="payroll-summary-divider" />
                        <div class="payroll-summary-tile is-gross">
                            <div class="label">Gross Salary</div>
                            <p class="value">@Model.TotalGrossSalary.ToString("N2")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
