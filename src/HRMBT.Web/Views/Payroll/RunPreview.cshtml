@model HRMBT.Web.Models.ViewModels.GeneratePayslipsVM
@using HRMBT.Web.Services.Payroll

@{
    ViewData["Title"] = "Payroll preview";
    ViewData["Module"] = "Payroll";
    var rows = ViewBag.Rows as List<PayrollCalculationService.PayrollPreviewRow> ?? new List<PayrollCalculationService.PayrollPreviewRow>();
    var willCreate = rows.Count(r => r.WillCreate);
    var skipped = rows.Count(r => !r.WillCreate);
    var withWarnings = rows.Count(r => r.WillCreate && r.Issues.Count > 0);
    var period = HRMBT.Web.Infrastructure.PayrollMonthHelper.FormatPeriod(Model.Month, Model.Year);
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
}

<div class="payslip-page py-4">
    <div class="container-fluid px-0">

        <div class="page-header-card p-4 mb-4">
            <h1 class="h2 mb-1 fw-bold text-dark"><i class="bi bi-search text-primary me-2"></i>Payroll preview: @period</h1>
            <p class="text-muted mb-0">
                @(string.IsNullOrWhiteSpace(Model.Department) ? "All departments" : Model.Department).
                Nothing has been saved. Employees with a warning are listed first.
            </p>
        </div>

        <div class="section-card mb-4">
            <div class="card-body p-3 p-lg-4 d-flex flex-wrap gap-4">
                <div><div class="h4 mb-0">@willCreate</div><div class="small text-muted">would get a payslip</div></div>
                <div><div class="h4 mb-0">@withWarnings</div><div class="small text-muted">of those have warnings</div></div>
                <div><div class="h4 mb-0">@skipped</div><div class="small text-muted">skipped</div></div>
            </div>
        </div>

        <div class="section-card mb-4">
            <div class="card-header"><i class="bi bi-table"></i>Employees</div>
            <div class="card-body">
                @if (rows.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-inboxes"></i><h5 class="mb-1">No active employees</h5></div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="payslip-grid">
                            <thead>
                                <tr>
                                    <th>Emp ID</th>
                                    <th>Employee</th>
                                    <th>Result</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in rows)
                                {
                                    <tr>
                                        <td class="font-monospace text-nowrap">@r.Employee.EmployeeID</td>
                                        <td>
                                            <div class="fw-semibold">@r.Employee.EmployeeName</div>
                                            <div class="small text-muted">@r.Employee.DesignationInfo?.Name</div>
                                        </td>
                                        <td class="text-nowrap">
                                            @if (!r.WillCreate) { <span class="text-muted">Skipped</span> }
                                            else if (r.Issues.Count > 0) { <span class="text-warning fw-semibold">Create, check notes</span> }
                                            else { <span class="text-success">Create</span> }
                                        </td>
                                        <td class="small">
                                            @if (r.Issues.Count == 0) { <span class="text-muted">—</span> }
                                            else
                                            {
                                                foreach (var i in r.Issues)
                                                {
                                                    <div class="@(i.Blocks ? "text-muted" : "text-danger")">@i.Text</div>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <form asp-action="GeneratePayslips" method="post" class="d-flex flex-wrap gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Department" value="@Model.Department" />
            <input type="hidden" name="Month" value="@Model.Month" />
            <input type="hidden" name="Year" value="@Model.Year" />
            <a asp-action="GeneratePayslips" class="btn btn-action-outline"><i class="bi bi-arrow-left-short me-1"></i>Back</a>
            <button type="submit" class="btn btn-action-primary" @(willCreate == 0 ? "disabled" : null)>
                <i class="bi bi-play-fill me-1"></i>Generate @willCreate payslip(s)
            </button>
        </form>
    </div>
</div>
