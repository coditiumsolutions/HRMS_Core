@using HRMBT.Web.Infrastructure
@model HRMBT.Web.Models.PaginatedList<HRMBT.Web.Models.Payslip>

@{
    ViewData["Title"] = "All Payrolls";
    ViewData["Module"] = "Payroll";
    var selectedMonthFilter = ViewBag.Month as string;
    var editBaseUrl = "";
    var deleteBaseUrl = Url.Action("Delete", "Payslips");
    var detailsBaseUrl = Url.Action("Details", "Payroll");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["Message"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        <div class="filter-card filter-card-compact mb-3">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Search &amp; filters</span>
            </div>
            <div class="card-body p-2 p-lg-3">
                @{
                    var selectedYearFilter = ViewBag.Year as int?;
                    var yearNow = DateTime.Now.Year;
                    var yearMin = yearNow - 10;
                    if (selectedYearFilter.HasValue && selectedYearFilter.Value < yearMin)
                    {
                        yearMin = selectedYearFilter.Value;
                    }
                }
                <form asp-action="Index" method="get" onsubmit="document.getElementById('pageInput').value = '1';">
                    <input type="hidden" name="page" id="pageInput" value="1" />
                    <input type="hidden" name="pageSize" value="@(ViewBag.CurrentPageSize ?? 20)" />
                    <div class="row g-1 g-md-2 align-items-center">
                        <div class="col-6 col-md">
                            <select name="month" id="month" class="form-select form-select-sm" aria-label="Month">
                                <option value="">All Months</option>
                                @foreach (var monthName in PayrollMonthHelper.AllMonthNames)
                                {
                                    <option value="@monthName" selected="@(string.Equals(selectedMonthFilter, monthName, StringComparison.OrdinalIgnoreCase))">@monthName</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md">
                            <select name="year" id="year" class="form-select form-select-sm" aria-label="Year">
                                <option value="">All Years</option>
                                @for (int y = yearNow + 1; y >= yearMin; y--)
                                {
                                    <option value="@y" selected="@(selectedYearFilter == y)">@y</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md">
                            <input type="text" name="search" id="search" class="form-control form-control-sm"
                                   value="@ViewBag.CurrentSearch" placeholder="Name or Employee ID…" aria-label="Search by name or employee ID" />
                        </div>
                        <div class="col-12 col-md">
                            <select name="department" id="department" class="form-select form-select-sm" aria-label="Department">
                                <option value="">All Departments</option>
                                @if (ViewBag.Departments != null)
                                {
                                    foreach (var dept in ViewBag.Departments)
                                    {
                                        var deptSelected = ViewBag.SelectedDepartment != null && ViewBag.SelectedDepartment.ToString() == dept;
                                        <option value="@dept" selected="@deptSelected">@dept</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-auto">
                            <button type="submit" class="btn btn-filter-apply btn-action-primary">
                                <i class="bi bi-funnel-fill me-1"></i>Apply
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>All payrolls</span>
                @if (Model != null && Model.Any())
                {
                    <div class="grid-selection-actions">
                        <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="payrollGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-details-base="@detailsBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>Employee</th>
                                    <th class="text-nowrap">Period</th>
                                    <th class="text-end col-salary">Basic</th>
                                    <th class="text-end col-salary">Net</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr data-record-id="@item.Id" data-can-edit="@(item.IsLocked ? "false" : "true")" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedPayslip" value="@item.Id"
                                                   aria-label="Select @(item.Employee?.EmployeeName)" />
                                        </td>
                                        <td>
                                            <div class="emp-name">@(item.Employee?.EmployeeName ?? "—")</div>
                                            <div class="emp-meta">@(item.Employee?.EmployeeID ?? ("#" + item.EmployeeId))</div>
                                        </td>
                                        <td class="text-nowrap">@item.Month @item.Year</td>
                                        <td class="text-end salary col-salary">@item.BasicSalary.ToString("N2")</td>
                                        <td class="text-end salary col-salary">@item.NetSalary.ToString("N2")</td>
                                        <td>
                                            @if (item.IsLocked)
                                            {
                                                <span class="status-pill status-inactive">Locked</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-active">Open</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted small px-3 py-2 mb-0 border-top">
                        Showing @Model.StartRecord to @Model.EndRecord of @Model.TotalCount payslip(s)
                        @{
                            var filters = new List<string>();
                            if (!string.IsNullOrWhiteSpace(selectedMonthFilter))
                            {
                                filters.Add(selectedMonthFilter);
                            }
                            if (ViewBag.Year != null)
                            {
                                filters.Add(ViewBag.Year.ToString());
                            }
                            if (ViewBag.CurrentSearch != null)
                            {
                                filters.Add($"Search: {ViewBag.CurrentSearch}");
                            }
                            if (ViewBag.SelectedDepartment != null)
                            {
                                filters.Add(ViewBag.SelectedDepartment.ToString());
                            }
                        }
                        @if (filters.Any())
                        {
                            <span> — @string.Join(", ", filters)</span>
                        }
                    </p>

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Payslip pagination" class="mt-2 px-3 pb-3">
                            <ul class="pagination justify-content-center mb-2">
                                @{
                                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                                    int startPage = Math.Max(1, Model.PageIndex - 2);
                                    int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                    if (endPage - startPage < 4)
                                    {
                                        if (startPage == 1) { endPage = Math.Min(Model.TotalPages, startPage + 4); }
                                        else if (endPage == Model.TotalPages) { startPage = Math.Max(1, endPage - 4); }
                                    }
                                }

                                <li class="page-item @prevDisabled">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="1"
                                       asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-month="@ViewBag.Month"
                                       asp-route-year="@ViewBag.Year"
                                       asp-route-search="@ViewBag.CurrentSearch"
                                       asp-route-department="@ViewBag.SelectedDepartment">&laquo;&laquo;</a>
                                </li>

                                <li class="page-item @prevDisabled">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@(Model.PageIndex - 1)"
                                       asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-month="@ViewBag.Month"
                                       asp-route-year="@ViewBag.Year"
                                       asp-route-search="@ViewBag.CurrentSearch"
                                       asp-route-department="@ViewBag.SelectedDepartment">&laquo;</a>
                                </li>

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    var active = i == Model.PageIndex ? "active" : "";
                                    <li class="page-item @active">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-page="@i"
                                           asp-route-pageSize="@ViewBag.CurrentPageSize"
                                           asp-route-month="@ViewBag.Month"
                                           asp-route-year="@ViewBag.Year"
                                           asp-route-search="@ViewBag.CurrentSearch"
                                           asp-route-department="@ViewBag.SelectedDepartment">@i</a>
                                    </li>
                                }

                                <li class="page-item @nextDisabled">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@(Model.PageIndex + 1)"
                                       asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-month="@ViewBag.Month"
                                       asp-route-year="@ViewBag.Year"
                                       asp-route-search="@ViewBag.CurrentSearch"
                                       asp-route-department="@ViewBag.SelectedDepartment">&raquo;</a>
                                </li>

                                <li class="page-item @nextDisabled">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@Model.TotalPages"
                                       asp-route-pageSize="@ViewBag.CurrentPageSize"
                                       asp-route-month="@ViewBag.Month"
                                       asp-route-year="@ViewBag.Year"
                                       asp-route-search="@ViewBag.CurrentSearch"
                                       asp-route-department="@ViewBag.SelectedDepartment">&raquo;&raquo;</a>
                                </li>
                            </ul>
                            <div class="text-center text-muted small">
                                Page @Model.PageIndex of @Model.TotalPages (Total: @Model.TotalCount records)
                            </div>
                        </nav>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        @if (ViewBag.RequiresPeriodFilter as bool? == true)
                        {
                            <h5 class="mb-1">Select month and year</h5>
                            <p class="mb-0">Choose a month and year, then click Apply to load payroll records.</p>
                        }
                        else
                        {
                            <h5 class="mb-1">No payroll records found</h5>
                            <p class="mb-0">No payslips match the selected filters.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
