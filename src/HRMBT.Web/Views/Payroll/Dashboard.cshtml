@using HRMBT.Web.Infrastructure
@model HRMBT.Web.Models.ViewModels.PayrollDashboardVM

@{
    ViewData["Title"] = "Payroll Dashboard";
    ViewData["Module"] = "Payroll";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-3">
<div class="container-fluid px-0">
    <div class="filter-card filter-card-tight mb-3">
        <div class="card-header">
            <span><i class="bi bi-speedometer2"></i>Payroll Dashboard <span class="text-muted small ms-1">@Model.Month @Model.Year</span></span>
        </div>
        <div class="card-body">
            <form asp-action="Dashboard" method="get" class="row g-2 align-items-end">
                <div class="col-sm-4 col-lg-3">
                    <label for="month" class="form-label">Month</label>
                    <select name="month" id="month" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var mName in PayrollMonthHelper.AllMonthNames)
                        {
                            <option value="@mName" selected="@(string.Equals(Model.Month, mName, StringComparison.OrdinalIgnoreCase))">@mName</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3 col-lg-2">
                    <label for="year" class="form-label">Year</label>
                    <input type="number" name="year" id="year" class="form-control form-control-sm" value="@Model.Year" min="2000" max="2100" onchange="this.form.submit()" />
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3"><div class="pay-kpi pay-kpi--navy"><div class="pay-kpi-label">Total employees</div><div class="pay-kpi-value">@Model.TotalEmployees</div></div></div>
        <div class="col-6 col-lg-3"><div class="pay-kpi pay-kpi--green"><div class="pay-kpi-label">Payroll generated</div><div class="pay-kpi-value">@Model.EmployeesWithPayrollGenerated</div></div></div>
        <div class="col-6 col-lg-3"><div class="pay-kpi pay-kpi--amber"><div class="pay-kpi-label">Payroll not generated</div><div class="pay-kpi-value">@Model.EmployeesWithoutPayroll</div></div></div>
        <div class="col-6 col-lg-3"><div class="pay-kpi pay-kpi--teal"><div class="pay-kpi-label">Total payroll amount</div><div class="pay-kpi-value">@Fmt.Amount(Model.TotalPayrollAmount)</div></div></div>
    </div>

    <!-- Charts Row -->
    <div class="row">
        <!-- Payroll Status Pie Chart -->
        <div class="col-lg-6 mb-3">
            <div class="grid-card">
                <div class="card-header"><span><i class="bi bi-bar-chart"></i>Payroll Status Distribution</span></div>
                <div class="card-body grid-form">
                    <canvas id="payrollStatusChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Payroll Amount Bar Chart -->
        <div class="col-lg-6 mb-3">
            <div class="grid-card">
                <div class="card-header"><span><i class="bi bi-bar-chart"></i>Payroll Overview</span></div>
                <div class="card-body grid-form">
                    <canvas id="payrollOverviewChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Charts Row -->
    <div class="row">
        <!-- Employee Count Comparison -->
        <div class="col-lg-6 mb-3">
            <div class="grid-card">
                <div class="card-header"><span><i class="bi bi-bar-chart"></i>Employee Payroll Status</span></div>
                <div class="card-body grid-form">
                    <canvas id="employeeStatusChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Donut Chart for Payroll Status -->
        <div class="col-lg-6 mb-3">
            <div class="grid-card">
                <div class="card-header"><span><i class="bi bi-bar-chart"></i>Payroll Completion Rate</span></div>
                <div class="card-body grid-form">
                    <canvas id="completionRateChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Chart data from model
        const totalEmployees = @Model.TotalEmployees;
        const employeesWithPayroll = @Model.EmployeesWithPayrollGenerated;
        const employeesWithoutPayroll = @Model.EmployeesWithoutPayroll;
        const totalPayrollAmount = @Model.TotalPayrollAmount;

        // Payroll Status Pie Chart
        const payrollStatusCtx = document.getElementById('payrollStatusChart').getContext('2d');
        new Chart(payrollStatusCtx, {
            type: 'pie',
            data: {
                labels: ['Payroll Generated', 'Payroll Not Generated'],
                datasets: [{
                    data: [employeesWithPayroll, employeesWithoutPayroll],
                    backgroundColor: ['#28a745', '#ffc107'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                label += context.parsed + ' employees';
                                return label;
                            }
                        }
                    }
                }
            }
        });

        // Payroll Overview Bar Chart
        const payrollOverviewCtx = document.getElementById('payrollOverviewChart').getContext('2d');
        new Chart(payrollOverviewCtx, {
            type: 'bar',
            data: {
                labels: ['Total Employees', 'With Payroll', 'Without Payroll'],
                datasets: [{
                    label: 'Number of Employees',
                    data: [totalEmployees, employeesWithPayroll, employeesWithoutPayroll],
                    backgroundColor: ['#007bff', '#28a745', '#ffc107'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });

        // Employee Status Bar Chart
        const employeeStatusCtx = document.getElementById('employeeStatusChart').getContext('2d');
        new Chart(employeeStatusCtx, {
            type: 'bar',
            data: {
                labels: ['Payroll Generated', 'Payroll Not Generated'],
                datasets: [{
                    label: 'Employees',
                    data: [employeesWithPayroll, employeesWithoutPayroll],
                    backgroundColor: ['#28a745', '#ffc107'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });

        // Completion Rate Donut Chart
        const completionRateCtx = document.getElementById('completionRateChart').getContext('2d');
        const completionRate = totalEmployees > 0 ? ((employeesWithPayroll / totalEmployees) * 100).toFixed(1) : 0;
        new Chart(completionRateCtx, {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending'],
                datasets: [{
                    data: [employeesWithPayroll, employeesWithoutPayroll],
                    backgroundColor: ['#28a745', '#ffc107'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                label += context.parsed + ' employees';
                                if (label.includes('Completed')) {
                                    label += ' (' + completionRate + '%)';
                                }
                                return label;
                            }
                        }
                    }
                }
            }
        });
    </script>
}

