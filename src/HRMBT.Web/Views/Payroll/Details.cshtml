@model HRMBT.Web.Models.Payslip

@{
    ViewData["Title"] = "Payroll Details";
    ViewData["Module"] = "Payroll";
    var empName = Model.Employee?.EmployeeName;
    var empCode = Model.Employee?.EmployeeID;

    var allowanceLines = (Model.PayslipDetails ?? Enumerable.Empty<HRMBT.Web.Models.PayslipDetail>())
        .Where(d => string.Equals(d.ItemType, "Allowance", StringComparison.OrdinalIgnoreCase))
        .OrderBy(d => d.SortOrder ?? int.MaxValue)
        .ToList();
    var deductionLines = (Model.PayslipDetails ?? Enumerable.Empty<HRMBT.Web.Models.PayslipDetail>())
        .Where(d => string.Equals(d.ItemType, "Deduction", StringComparison.OrdinalIgnoreCase))
        .OrderBy(d => d.SortOrder ?? int.MaxValue)
        .ToList();
    var taxLines = (Model.PayslipDetails ?? Enumerable.Empty<HRMBT.Web.Models.PayslipDetail>())
        .Where(d => string.Equals(d.ItemType, "Tax", StringComparison.OrdinalIgnoreCase))
        .OrderBy(d => d.SortOrder ?? int.MaxValue)
        .ToList();
    var payrollDedTotal = deductionLines.Count > 0 ? deductionLines.Sum(l => l.Amount) : Model.TotalDeductions;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/payslips.css" asp-append-version="true" />
}

<div class="payslip-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">All Payrolls</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details #@Model.Id</li>
            </ol>
        </nav>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="grid-card mb-3" id="payrollDetailsPrintArea">
            <div class="card-header">
                <span><i class="bi bi-receipt"></i>Payroll details</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="payroll-details-table mb-0">
                        <tbody>
                            <tr>
                                <th scope="row" class="pd-label">Name</th>
                                <td class="pd-value">@(string.IsNullOrWhiteSpace(empName) ? "—" : empName)</td>
                                <th scope="row" class="pd-label">Employee ID</th>
                                <td class="pd-value">@(string.IsNullOrWhiteSpace(empCode) ? Model.EmployeeId.ToString() : empCode)</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Payslip ID</th>
                                <td class="pd-value">@Model.Id</td>
                                <th scope="row" class="pd-label">Month / Year</th>
                                <td class="pd-value">@Model.Month / @Model.Year</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Basic Salary</th>
                                <td class="pd-value">@Model.BasicSalary.ToString("N2")</td>
                                <th scope="row" class="pd-label">Total Allowances</th>
                                <td class="pd-value">@(Model.TotalAllowances.HasValue ? Model.TotalAllowances.Value.ToString("N2") : "—")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Gross Salary</th>
                                <td class="pd-value">@Model.GrossSalary.ToString("N2")</td>
                                <th scope="row" class="pd-label">Tax Percentage</th>
                                <td class="pd-value">@Model.TaxPercentage.ToString("N2")%</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Tax Amount</th>
                                <td class="pd-value">@Model.TaxAmount.ToString("N2")</td>
                                <th scope="row" class="pd-label">Total Deductions</th>
                                <td class="pd-value">@payrollDedTotal.ToString("N2")</td>
                            </tr>
                            <tr>
                                <th scope="row" class="pd-label">Net Salary</th>
                                <td class="pd-value pd-value-emphasis">@Model.NetSalary.ToString("N2")</td>
                                <th scope="row" class="pd-label">Generated Date</th>
                                <td class="pd-value">@Model.GeneratedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                            @if (Model.WorkingDays.HasValue || Model.LeaveDays.HasValue)
                            {
                                <tr>
                                    <th scope="row" class="pd-label">Working Days</th>
                                    <td class="pd-value">@(Model.WorkingDays?.ToString() ?? "—")</td>
                                    <th scope="row" class="pd-label">Leave Days</th>
                                    <td class="pd-value">@(Model.LeaveDays?.ToString("N2") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (allowanceLines.Count > 0)
                {
                    <div class="px-3 pt-3">
                        <div class="fw-semibold text-dark mb-2"><i class="bi bi-plus-circle me-1 text-success"></i>Allowances</div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th class="text-end">Amount (PKR)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in allowanceLines)
                                    {
                                        <tr>
                                            <td>@line.ItemName</td>
                                            <td>@(string.IsNullOrWhiteSpace(line.ItemCategory) ? "—" : line.ItemCategory)</td>
                                            <td class="text-end">@line.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <div class="px-3 py-3">
                    <div class="fw-semibold text-dark mb-2"><i class="bi bi-dash-circle me-1 text-danger"></i>Deductions</div>
                    @if (deductionLines.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th class="text-end">Amount (PKR)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in deductionLines)
                                    {
                                        <tr>
                                            <td>@line.ItemName</td>
                                            <td>@(string.IsNullOrWhiteSpace(line.ItemCategory) ? "—" : line.ItemCategory)</td>
                                            <td class="text-end">@line.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr class="table-light">
                                        <td colspan="2" class="fw-semibold">Total deductions</td>
                                        <td class="text-end fw-semibold">@payrollDedTotal.ToString("N2")</td>
                                    </tr>
                                    @foreach (var line in taxLines)
                                    {
                                        <tr>
                                            <td>@line.ItemName</td>
                                            <td>@(string.IsNullOrWhiteSpace(line.ItemCategory) ? "—" : line.ItemCategory)</td>
                                            <td class="text-end">@line.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    @if (taxLines.Count == 0 && Model.TaxAmount > 0)
                                    {
                                        <tr>
                                            <td>Income Tax</td>
                                            <td>@Model.TaxPercentage.ToString("N2")% of Basic</td>
                                            <td class="text-end">@Model.TaxAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            No individual deduction lines on this payslip
                            @(Model.TotalDeductions > 0 ? $"(header total: {Model.TotalDeductions:N2}). Re-generate payroll to store each deduction separately." : ".")
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-end mb-4 no-print">
            <a asp-action="Index" class="btn btn-sm btn-action-secondary"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
            <a asp-controller="Payslips" asp-action="Print" asp-route-id="@Model.Id" class="btn btn-sm btn-action-outline" target="_blank">
                <i class="bi bi-printer me-1"></i>Print salary slip
            </a>
            <button type="button" class="btn btn-sm btn-action-primary" id="btnPrintPayrollDetails">
                <i class="bi bi-printer me-1"></i>Print
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var btn = document.getElementById('btnPrintPayrollDetails');
            if (!btn) return;
            btn.addEventListener('click', function () {
                window.print();
            });
        })();
    </script>
}
