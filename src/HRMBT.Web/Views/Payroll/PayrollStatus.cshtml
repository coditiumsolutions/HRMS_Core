@model HRMBT.Web.Models.PaginatedList<HRMBT.Web.Models.Employee>

@{
    ViewData["Title"] = "Payroll Status";
    ViewData["Module"] = "Payroll";
    var payslipLookup = ViewBag.PayslipLookup as Dictionary<int, HRMBT.Web.Models.Payslip> ?? new Dictionary<int, HRMBT.Web.Models.Payslip>();
    var actualYear = ViewBag.ActualYear as int?;
    var hasSearched = ViewBag.HasSearched as bool? ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <div class="toolbar-card mb-4">
            <div class="toolbar-header">
                <span><i class="bi bi-cash-stack"></i>Payroll Status Report</span>
            </div>
            <div class="p-3 px-lg-4 pb-0">
                <p class="text-muted small mb-0">Identify employees by their payroll generation status for a selected month and year.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">@Html.Raw(TempData["SuccessMessage"])</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div class="flex-grow-1">@Html.Raw(TempData["ErrorMessage"])</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card mb-4">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Filter options</span>
            </div>
            <div class="card-body p-3 p-lg-4">
                <form asp-action="PayrollStatus" method="get" class="row g-3 align-items-end" onsubmit="document.getElementById('statusPageInput').value = '1';">
                    <input type="hidden" name="page" id="statusPageInput" value="1" />
                    <input type="hidden" name="pageSize" value="@(ViewBag.CurrentPageSize ?? 20)" />

                    <div class="col-12 col-md">
                        <label for="year" class="form-label">Year</label>
                        <select name="year" id="year" class="form-select">
                            <option value="">-- Select Year --</option>
                            @{
                                int currentYear = DateTime.Now.Year;
                                int previousYear = currentYear - 1;
                                string selectedYear = ViewBag.Year?.ToString();
                            }
                            <option value="@previousYear" selected="@(selectedYear != null && selectedYear == previousYear.ToString())">@previousYear</option>
                            <option value="@currentYear" selected="@(selectedYear == null || selectedYear == currentYear.ToString())">@currentYear</option>
                        </select>
                    </div>

                    <div class="col-12 col-md">
                        <label for="month" class="form-label">Month</label>
                        @{
                            var selectedMonthFilter = ViewBag.Month as string;
                        }
                        <select name="month" id="month" class="form-select">
                            <option value="">-- Select Month --</option>
                            @foreach (var monthName in HRMBT.Web.Infrastructure.PayrollMonthHelper.AllMonthNames)
                            {
                                <option value="@monthName" selected="@(string.Equals(selectedMonthFilter, monthName, StringComparison.OrdinalIgnoreCase))">@monthName</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md">
                        <label for="department" class="form-label">Department</label>
                        <select name="department" id="department" class="form-select">
                            <option value="">All Departments</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    var isSelected = ViewBag.Department != null && ViewBag.Department.ToString() == dept;
                                    <option value="@dept" selected="@isSelected">@dept</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md">
                        <label for="payrollStatus" class="form-label">Payroll Status</label>
                        <select name="payrollStatus" id="payrollStatus" class="form-select">
                            <option value="Payroll Not Generated" selected="@(ViewBag.PayrollStatus?.ToString() == "Payroll Not Generated" || ViewBag.PayrollStatus == null)">Payroll Not Generated</option>
                            <option value="Payroll Generated" selected="@(ViewBag.PayrollStatus?.ToString() == "Payroll Generated")">Payroll Generated</option>
                            <option value="Payroll Pending" selected="@(ViewBag.PayrollStatus?.ToString() == "Payroll Pending")">Payroll Pending</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-auto d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-action-primary">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                        <a asp-action="PayrollStatus" class="btn btn-action-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header">
                <span>
                    <i class="bi bi-table"></i>
                    @if (hasSearched && actualYear.HasValue && ViewBag.Month != null)
                    {
                        <text>Results for @ViewBag.Month @actualYear</text>
                        @if (!string.IsNullOrWhiteSpace(ViewBag.Department?.ToString()))
                        {
                            <text> — @ViewBag.Department</text>
                        }
                        <text> (@ViewBag.PayrollStatus)</text>
                    }
                    else
                    {
                        <text>Search results</text>
                    }
                </span>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid">
                            <thead>
                                <tr>
                                    <th>Employee ID</th>
                                    <th>Employee Name</th>
                                    <th>Department</th>
                                    <th>Designation</th>
                                    <th class="text-end">Basic Salary</th>
                                    <th>Payroll Status</th>
                                    <th class="text-end" style="width:160px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var hasPayslip = payslipLookup.ContainsKey(item.uid);
                                    var statusPill = "";
                                    var statusText = "";

                                    if (!hasPayslip)
                                    {
                                        statusPill = "status-inactive";
                                        statusText = "Not Generated";
                                    }
                                    else if (payslipLookup[item.uid].IsLocked)
                                    {
                                        statusPill = "status-active";
                                        statusText = "Generated";
                                    }
                                    else
                                    {
                                        statusPill = "status-pending";
                                        statusText = "Pending";
                                    }

                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.EmployeeID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.EmployeeName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Department)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Designation)</td>
                                        <td class="text-end salary">
                                            @if (item.BasicSalary.HasValue)
                                            {
                                                @item.BasicSalary.Value.ToString("N2")
                                            }
                                        </td>
                                        <td>
                                            <span class="status-pill @statusPill">@statusText</span>
                                        </td>
                                        <td class="text-end">
                                            @if (hasPayslip)
                                            {
                                                <div class="row-actions">
                                                    <a class="btn btn-view" asp-action="Details" asp-route-id="@payslipLookup[item.uid].Id" title="View Payslip" data-bs-toggle="tooltip">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <a asp-action="GenerateIndividual" class="btn btn-action-success btn-sm">Generate</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted small px-3 py-2 mb-0">
                        Showing @Model.StartRecord to @Model.EndRecord of @Model.TotalCount employee(s)
                    </p>

                    @if (Model.TotalPages > 1)
                    {
                        <div class="d-flex flex-column align-items-center gap-2 px-3 pb-3">
                            <nav aria-label="Payroll status pagination" class="mb-0">
                                <ul class="pagination justify-content-center flex-wrap mb-0">
                                    @{
                                        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                                        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                                        int startPage = Math.Max(1, Model.PageIndex - 2);
                                        int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                        if (endPage - startPage < 4)
                                        {
                                            if (startPage == 1) { endPage = Math.Min(Model.TotalPages, startPage + 4); }
                                            else if (endPage == Model.TotalPages) { startPage = Math.Max(1, endPage - 4); }
                                        }
                                    }

                                    <li class="page-item @prevDisabled">
                                        <a class="page-link" asp-action="PayrollStatus"
                                           asp-route-page="1"
                                           asp-route-pageSize="@ViewBag.CurrentPageSize"
                                           asp-route-year="@ViewBag.Year"
                                           asp-route-month="@ViewBag.Month"
                                           asp-route-department="@ViewBag.Department"
                                           asp-route-payrollStatus="@ViewBag.PayrollStatus"
                                           aria-label="First"><i class="bi bi-chevron-bar-left"></i></a>
                                    </li>

                                    <li class="page-item @prevDisabled">
                                        <a class="page-link" asp-action="PayrollStatus"
                                           asp-route-page="@(Model.PageIndex - 1)"
                                           asp-route-pageSize="@ViewBag.CurrentPageSize"
                                           asp-route-year="@ViewBag.Year"
                                           asp-route-month="@ViewBag.Month"
                                           asp-route-department="@ViewBag.Department"
                                           asp-route-payrollStatus="@ViewBag.PayrollStatus"
                                           aria-label="Previous"><i class="bi bi-chevron-left"></i></a>
                                    </li>

                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        var active = i == Model.PageIndex ? "active" : "";
                                        <li class="page-item @active">
                                            <a class="page-link" asp-action="PayrollStatus"
                                               asp-route-page="@i"
                                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                                               asp-route-year="@ViewBag.Year"
                                               asp-route-month="@ViewBag.Month"
                                               asp-route-department="@ViewBag.Department"
                                               asp-route-payrollStatus="@ViewBag.PayrollStatus">@i</a>
                                        </li>
                                    }

                                    <li class="page-item @nextDisabled">
                                        <a class="page-link" asp-action="PayrollStatus"
                                           asp-route-page="@(Model.PageIndex + 1)"
                                           asp-route-pageSize="@ViewBag.CurrentPageSize"
                                           asp-route-year="@ViewBag.Year"
                                           asp-route-month="@ViewBag.Month"
                                           asp-route-department="@ViewBag.Department"
                                           asp-route-payrollStatus="@ViewBag.PayrollStatus"
                                           aria-label="Next"><i class="bi bi-chevron-right"></i></a>
                                    </li>

                                    <li class="page-item @nextDisabled">
                                        <a class="page-link" asp-action="PayrollStatus"
                                           asp-route-page="@Model.TotalPages"
                                           asp-route-pageSize="@ViewBag.CurrentPageSize"
                                           asp-route-year="@ViewBag.Year"
                                           asp-route-month="@ViewBag.Month"
                                           asp-route-department="@ViewBag.Department"
                                           asp-route-payrollStatus="@ViewBag.PayrollStatus"
                                           aria-label="Last"><i class="bi bi-chevron-bar-right"></i></a>
                                    </li>
                                </ul>
                            </nav>
                            <div class="text-center text-muted small mb-0">
                                Page @Model.PageIndex of @Model.TotalPages (Total: @Model.TotalCount records)
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        @if (!hasSearched)
                        {
                            <h5 class="mb-1">Ready to search</h5>
                            <p class="mb-0">Please select Year and Month, then click Search to view payroll status.</p>
                        }
                        else
                        {
                            <h5 class="mb-1">No employees found</h5>
                            <p class="mb-0">No employees found matching the selected criteria.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            if (window.bootstrap) {
                document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                    new bootstrap.Tooltip(el);
                });
            }
        })();
    </script>
}
