@model HRMBT.Web.Models.ViewModels.LeaveCalendarVm
@{
    ViewData["Title"] = "Who's on leave";
    var monthName = Model.Month.ToString("MMMM yyyy");
    var previous = Model.Month.AddMonths(-1).ToString("yyyy-MM");
    var next = Model.Month.AddMonths(1).ToString("yyyy-MM");
    var today = DateTime.Today;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-0">
        <partial name="_Alerts" />

        <div class="filter-card filter-card-tight mb-3">
            <div class="card-header"><span><i class="bi bi-funnel"></i>Search &amp; Filters</span></div>
            <div class="card-body">
                <form method="get" asp-action="Calendar" class="row g-2 align-items-end">
                    <div class="col-12 col-md">
                        <label class="form-label" for="month">Month</label>
                        <input type="month" name="month" id="month" class="form-control form-control-sm" value="@Model.Month.ToString("yyyy-MM")" />
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="project">Project</label>
                        <select name="project" id="project" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var p in Model.Projects)
                            {
                                <option value="@p" selected="@(Model.Project == p)">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="department">Department</label>
                        <select name="department" id="department" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d" selected="@(Model.Department == d)">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto">
                        <button type="submit" class="btn btn-filter-apply w-100"><i class="bi bi-funnel-fill me-1"></i>Apply</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-calendar-range"></i>On leave, @monthName <span class="text-muted small ms-1">(@Model.Rows.Count people)</span></span>
                <span class="d-flex gap-2">
                    <a class="btn btn-sm btn-grid-edit" asp-action="Calendar" asp-route-month="@previous" asp-route-project="@Model.Project" asp-route-department="@Model.Department" >&lsaquo; Previous</a>
                    <a class="btn btn-sm btn-grid-edit" asp-action="Calendar" asp-route-month="@next" asp-route-project="@Model.Project" asp-route-department="@Model.Department" >Next &rsaquo;</a>
                </span>
            </div>
            <div class="card-body">
                <div class="month-key grid-note">
                    <span><i class="leave-cal__key--approved"></i>Approved</span>
                    <span><i class="leave-cal__key--pending"></i>Pending</span>
                    <span><i class="leave-cal__key--off"></i>Day off or holiday inside the leave (not charged)</span>
                    <span>The letter is the leave type. Click a day to open the request.</span>
                </div>
                @if (Model.Rows.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">Nobody is on leave</h5>
                        <p class="mb-0">No approved or pending leave in @monthName for these filters.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap leave-cal-wrap">
                        <table class="leave-cal">
                            <thead>
                                <tr>
                                    <th class="leave-cal__id">Emp ID</th>
                                    <th class="leave-cal__name">Employee</th>
                                    @foreach (var d in Model.Days)
                                    {
                                        <th class="leave-cal__day @(d.Holiday != null ? "is-holiday" : "") @(d.Date == today ? "is-today" : "")"
                                            title="@Fmt.ShortDate(d.Date)@(d.Holiday == null ? "" : $" · {d.Holiday}")">
                                            <span>@d.Date.ToString("ddd")[..2]</span>@d.Date.Day
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Rows)
                                {
                                    <tr>
                                        <td class="leave-cal__id"><span class="text-muted small emp-id-cell" title="@r.EmployeeCode">@r.EmployeeCode</span></td>
                                        <td class="leave-cal__name">
                                            <a class="leave-cal__person" asp-controller="EmployeeSchedule" asp-action="Month" asp-route-id="@r.Uid" asp-route-month="@Model.Month.ToString("yyyy-MM")">
                                                <span class="emp-name">@(r.Name ?? "—")</span>
                                                <span class="emp-meta">@(r.Designation ?? "—")</span>
                                            </a>
                                        </td>
                                        @for (var i = 0; i < Model.Days.Count; i++)
                                        {
                                            var c = r.Cells[i];
                                            <td class="leave-cal__day @(Model.Days[i].Holiday != null ? "is-holiday" : "")">
                                                @if (c != null)
                                                {
                                                    var what = $"{c.LeaveType}, {(c.Approved ? "approved" : "pending")}, {Fmt.ShortDate(Model.Days[i].Date)}{(c.WorkDay ? "" : " (not a work day)")}";
                                                    <a asp-action="Details" asp-route-id="@c.LeaveRequestId" title="@what" aria-label="@what"
                                                       class="leave-cal__mark @(!c.WorkDay ? "is-off" : c.Approved ? "is-approved" : "is-pending")">@(c.HalfDay ? "½" : c.LeaveType[..1])</a>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="leave-cal__id"></th>
                                    <th class="leave-cal__name">Away (+ pending)</th>
                                    @foreach (var d in Model.Days)
                                    {
                                        <td class="leave-cal__day @(d.Holiday != null ? "is-holiday" : "")">
                                            @(d.Approved > 0 ? d.Approved.ToString() : "")@if (d.Pending > 0) { <span class="leave-cal__pending-count">+@d.Pending</span> }
                                        </td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
