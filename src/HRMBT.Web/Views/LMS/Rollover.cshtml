@model List<HRMBT.Web.Services.RolloverRow>
@{
    ViewData["Title"] = "Year-end rollover";
    int year = (int)ViewBag.Year;
    int todo = Model.Count(r => r.Action == "New" || r.Action == "Update");
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}
<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">
        <div class="toolbar-card mb-4">
            <div class="toolbar-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="bi bi-arrow-repeat"></i>Year-end rollover: @year into @(year + 1)</span>
                <div class="toolbar-actions d-flex flex-wrap gap-2">
                    <a asp-action="LeaveBalance" asp-route-year="@year" class="btn btn-action-secondary">Back to balances</a>
                </div>
            </div>
        </div>

        <form method="get" asp-action="Rollover" class="d-flex flex-wrap align-items-end gap-2 mb-3">
            <div>
                <label class="form-label mb-1" for="year">Roll balances of year</label>
                <input type="number" class="form-control" name="year" id="year" value="@year" min="2000" max="2100" />
            </div>
            <button type="submit" class="btn btn-action-secondary">Preview</button>
        </form>

        <p class="text-muted">
            The remaining balance at the end of @year (never below zero, limited by the cap of each leave type) is written as carry-forward into @(year + 1).
            Leave types set to "no carry-forward" in Setup &rarr; Lists are skipped. Rows entered by hand are never changed; rows from an earlier rollover are updated, so it is safe to run again after late approvals.
        </p>

        @if (todo > 0)
        {
            <form method="post" asp-action="Rollover" class="mb-3" onsubmit="return confirm('Write @todo carry-forward rows into @(year + 1)?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@year" />
                <input type="hidden" name="apply" value="true" />
                <button type="submit" class="btn btn-action-primary"><i class="bi bi-check2-circle me-1"></i>Apply: write @todo rows</button>
            </form>
        }

        <div class="table-wrap table-responsive">
            <table class="employee-grid">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Name</th>
                        <th>Leave type</th>
                        <th class="text-end">Remaining @year</th>
                        <th class="text-end">Carry into @(year + 1)</th>
                        <th class="text-end">Now recorded</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.EmployeeCode</td>
                            <td>@(r.EmployeeName ?? "—")</td>
                            <td>@r.LeaveType</td>
                            <td class="text-end">@Fmt.Days(r.Remaining)</td>
                            <td class="text-end fw-semibold">@Fmt.Days(r.Amount)</td>
                            <td class="text-end">@(r.Existing.HasValue ? Fmt.Days(r.Existing) : "—")</td>
                            <td>@(r.Action == "Manual" ? "Entered by hand, left alone" : r.Action)</td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Nothing to carry forward from @year (no remaining balance, or no balances for that year).</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
