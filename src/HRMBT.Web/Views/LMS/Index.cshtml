@model IEnumerable<HRMBT.Web.Models.ViewModels.LmsLeaveRowVm>

@{
    ViewData["Title"] = "Leave Management System";
    var filterSearch = ViewBag.CurrentSearch as string;
    var filterStatus = ViewBag.CurrentStatus as string;
    var filterLeaveType = ViewBag.CurrentLeaveType as string;
    var leaveTypesList = ViewBag.LeaveTypes as List<string>;
    var editBaseUrl = Url.Action("Edit", "LMS", new { id = "__id__" });
        var detailsBaseUrl = Url.Action("Details", "LMS", new { id = "__id__" });
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-0">

        <partial name="_Alerts" />
        @if (ViewBag.Employee is HRMBT.Web.Models.Employee one)
        {
            <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2">
                <span>Leave requests of <a asp-controller="Employee" asp-action="Details" asp-route-id="@one.uid">@one.EmployeeName</a> (ID @one.EmployeeID) only.</span>
                <a asp-controller="EmployeeSchedule" asp-action="Month" asp-route-id="@one.uid" class="ms-auto">Month view</a>
                <a asp-action="Index">Show everyone</a>
            </div>
        }

        <div class="filter-card filter-card-tight mb-3">
            <div class="card-header"><span><i class="bi bi-funnel"></i>Search &amp; Filters</span></div>
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-2 align-items-end">
                    <input type="hidden" name="employeeId" value="@((ViewBag.Employee as HRMBT.Web.Models.Employee)?.uid)" />
                    <div class="col-12 col-md">
                        <label class="form-label" for="search">Search</label>
                        <div class="position-relative">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" name="search" id="search" class="form-control form-control-sm search-input" value="@filterSearch" placeholder="Name or Employee ID…" />
                        </div>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="status">Status</label>
                        <select name="status" id="status" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var s in new[] { "Pending", "Approved", "Rejected", "Cancelled" })
                            {
                                <option value="@s" selected="@(filterStatus == s)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="leaveType">Leave type</label>
                        <select name="leaveType" id="leaveType" class="form-select form-select-sm">
                            <option value="">All</option>
                            @if (leaveTypesList != null)
                            {
                                foreach (var leaveType in leaveTypesList)
                                {
                                    <option value="@leaveType" selected="@(leaveType == filterLeaveType)">@leaveType</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-filter-apply w-100"><i class="bi bi-funnel-fill me-1"></i>Apply</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Leave requests</span>
                <a class="btn btn-sm btn-grid-edit" asp-action="Create" asp-route-employeeId="@((ViewBag.Employee as HRMBT.Web.Models.Employee)?.uid)"><i class="bi bi-plus-lg me-1"></i>New request</a>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="lmsGrid"
                               data-edit-base="@editBaseUrl"
                               data-details-base="@detailsBaseUrl">
                            <thead>
                                <tr>
                                    <th class="col-emp-id">Emp ID</th>
                                    <th>Employee</th>
                                    <th>Leave type</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Days charged</th>
                                    <th>Status</th>
                                    <th class="col-actions text-center" data-align="none" scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var statusClass = item.Status switch
                                    {
                                        "Approved" => "status-active",
                                        "Rejected" => "status-inactive",
                                        "Cancelled" => "status-default",
                                        _ => "status-pending"
                                    };
                                    <tr data-record-id="@item.Id" title="Double-click to open">
                                        <td class="col-emp-id"><span class="text-muted small emp-id-cell" title="@item.EmployeeCode">@item.EmployeeCode</span></td>
                                        <td>
                                            <div class="emp-name">@(item.EmployeeName ?? "—")</div>
                                            <div class="emp-meta">@(string.IsNullOrWhiteSpace(item.EmployeeDesignation) ? "—" : item.EmployeeDesignation)</div>
                                        </td>
                                        <td class="text-nowrap">@item.LeaveType</td>
                                        <td class="text-nowrap">@Fmt.ShortDate(item.FromDate)</td>
                                        <td class="text-nowrap">@Fmt.ShortDate(item.ToDate)</td>
                                        <td>@Fmt.Days(item.TotalDays)</td>
                                        <td><span class="status-pill @statusClass">@(item.Status ?? "—")</span></td>
                                        <td class="col-actions">
                                            <a class="row-action row-action-edit" asp-controller="LMS" asp-action="Edit" asp-route-id="@item.Id" title="Edit leave request" aria-label="Edit leave request"><i class="bi bi-pencil-square"></i></a>
                                            @if (item.Status is "Pending" or "Approved")
                                            {
                                                <a class="row-action row-action-delete" asp-controller="LMS" asp-action="Cancel" asp-route-id="@item.Id" title="Cancel leave request" aria-label="Cancel leave request"><i class="bi bi-x-circle"></i></a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No leave requests found</h5>
                        <p class="mb-0">No leave requests match the current filters.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
