@model IEnumerable<HRMBT.Web.Models.ViewModels.LmsLeaveRowVm>

@{
    ViewData["Title"] = "Leave Management System";
    var filterSearch = ViewBag.CurrentSearch as string;
    var filterStatus = ViewBag.CurrentStatus as string;
    var filterLeaveType = ViewBag.CurrentLeaveType as string;
    var leaveTypesList = ViewBag.LeaveTypes as List<string>;
    var editBaseUrl = Url.Action("Edit", "LMS");
    var deleteBaseUrl = Url.Action("Delete", "LMS");
    var detailsBaseUrl = Url.Action("Details", "LMS");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card mb-4">
            <div class="card-header"><span><i class="bi bi-funnel"></i>Search &amp; filters</span></div>
            <div class="card-body p-3 p-lg-4">
                <form asp-action="Index" method="get" class="row g-3 align-items-end">
                    <div class="col-12 col-md">
                        <label class="form-label" for="search">Search</label>
                        <input type="text" name="search" id="search" class="form-control" value="@filterSearch" placeholder="Name or Employee ID…" />
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="" selected="@(string.IsNullOrEmpty(filterStatus))">All Statuses</option>
                            <option value="Applied" selected="@(filterStatus == "Applied")">Applied</option>
                            <option value="Approved" selected="@(filterStatus == "Approved")">Approved</option>
                            <option value="Rejected" selected="@(filterStatus == "Rejected")">Rejected</option>
                            <option value="Cancelled" selected="@(filterStatus == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label">Leave Type</label>
                        <select name="leaveType" class="form-select">
                            <option value="" selected="@(string.IsNullOrEmpty(filterLeaveType))">All Leave Types</option>
                            @if (leaveTypesList != null)
                            {
                                @foreach (var leaveType in leaveTypesList)
                                {
                                    <option value="@leaveType" selected="@(leaveType == filterLeaveType)">@leaveType</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-action-primary w-100"><i class="bi bi-funnel-fill me-1"></i>Apply</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Leave requests</span>
                @if (Model != null && Model.Any())
                {
                    <div class="grid-selection-actions">
                        <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="lmsGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-details-base="@detailsBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>ID</th>
                                    <th>Employee</th>
                                    <th>Leave type</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Calendar days</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var statusClass = item.Status switch
                                    {
                                        "Approved" => "status-active",
                                        "Rejected" => "status-inactive",
                                        "Cancelled" => "status-default",
                                        _ => "status-pending"
                                    };
                                    <tr data-record-id="@item.Id" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedLeave" value="@item.Id" aria-label="Select leave @item.Id" />
                                        </td>
                                        <td>@item.Id</td>
                                        <td>
                                            <div class="emp-name">@item.EmployeeCode</div>
                                            @if (!string.IsNullOrEmpty(item.EmployeeName))
                                            {
                                                <div class="emp-meta">@item.EmployeeName</div>
                                            }
                                        </td>
                                        <td>@item.LeaveType</td>
                                        <td class="text-nowrap">@item.FromDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-nowrap">@item.ToDate.ToString("yyyy-MM-dd")</td>
                                        <td>@item.CalendarDays</td>
                                        <td><span class="status-pill @statusClass">@(item.Status ?? "—")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No leave requests found</h5>
                        <p class="mb-0">No leave requests match the current filters.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
