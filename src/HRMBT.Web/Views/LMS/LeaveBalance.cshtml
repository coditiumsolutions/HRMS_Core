@model HRMBT.Web.Models.ViewModels.LmsLeaveBalancePageVm

@{
    ViewData["Title"] = "Leave balance";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-0">

        <partial name="_Alerts" />
        @if (ViewBag.EmployeeId != null)
        {
            <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2">
                <span>Showing one employee.</span>
                <a asp-action="LeaveBalance" asp-route-year="@Model.SelectedYear" class="ms-auto">Show everyone</a>
            </div>
        }

        <div class="filter-card filter-card-tight mb-3">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Search &amp; Filters</span>
            </div>
            <div class="card-body">
                <form asp-action="LeaveBalance" method="get" class="row g-2 align-items-end">
                    <input type="hidden" name="employeeId" value="@ViewBag.EmployeeId" />
                    <div class="col-12 col-md">
                        <label class="form-label" for="year">Year</label>
                        <select name="year" id="year" class="form-select form-select-sm" required>
                            @foreach (var y in Model.YearChoices)
                            {
                                var ySel = string.Equals(y, Model.SelectedYear, StringComparison.OrdinalIgnoreCase);
                                if (ySel)
                                {
                                    <option value="@y" selected>@y</option>
                                }
                                else
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="department">Department</label>
                        <select name="department" id="department" class="form-select form-select-sm">
                            @foreach (var d in Model.DepartmentChoices)
                            {
                                var dSel = string.Equals(d.Value, Model.SelectedDepartment, StringComparison.OrdinalIgnoreCase);
                                if (dSel)
                                {
                                    <option value="@d.Value" selected>@d.Label</option>
                                }
                                else
                                {
                                    <option value="@d.Value">@d.Label</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-filter-apply w-100">
                            <i class="bi bi-funnel-fill me-1"></i>Apply
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Leave balances</span>
                <a class="btn btn-sm btn-grid-edit" asp-action="Rollover" asp-route-year="@(int.TryParse(Model.SelectedYear, out var selYear) ? selYear - 1 : DateTime.Now.Year - 1)">Year-end rollover</a>
            </div>
            <div class="card-body">
                <p class="grid-note">
                    For each leave type, <strong>balance</strong> = <strong>available</strong> (quota, carry-forward and adjustments) minus days of <strong>approved</strong> requests in that year. Pending requests are shown but not yet subtracted.
                </p>

                @if (Model.Rows.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No rows to show</h5>
                        <p class="mb-0">Check leave quota for the selected year, or choose another department.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid">
                            <thead>
                                <tr>
                                    <th class="col-emp-id">Emp ID</th>
                                    <th>Employee</th>
                                    <th>Leave type</th>
                                    <th class="text-end">Carried forward</th>
                                    <th class="text-end">Available leave</th>
                                    <th class="text-end">Availed leave</th>
                                    <th class="text-end">Pending</th>
                                    <th class="text-end">Balance leave</th>
                                    <th class="col-actions text-center" data-align="none" scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Rows)
                                {
                                    <tr>
                                        <td class="col-emp-id"><span class="text-muted small emp-id-cell" title="@row.EmployeeCode">@row.EmployeeCode</span></td>
                                        <td>
                                            <div class="emp-name">@(row.EmployeeName ?? "—")</div>
                                            <div class="emp-meta">@(row.Designation ?? "—")</div>
                                        </td>
                                        <td class="text-nowrap">@row.LeaveTypeName</td>
                                        <td class="text-end">@Fmt.Days(row.CarryForwardLeaves)</td>
                                        <td class="text-end">@Fmt.Days(row.AvailableLeaves)</td>
                                        <td class="text-end">@Fmt.Days(row.AvailedLeaves)</td>
                                        <td class="text-end">@Fmt.Days(row.PendingLeaves)</td>
                                        <td class="text-end @(row.BalanceLeaves < 0 ? "text-danger" : "")">@Fmt.Days(row.BalanceLeaves)</td>
                                        <td class="col-actions">
                                            <a class="row-action row-action-view" asp-controller="EmployeeSchedule" asp-action="Month" asp-route-id="@row.EmployeeUid" title="Month view" aria-label="Month view of @row.EmployeeCode"><i class="bi bi-calendar3"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
