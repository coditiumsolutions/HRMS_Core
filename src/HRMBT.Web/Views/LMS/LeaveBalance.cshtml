@model HRMBT.Web.Models.ViewModels.LmsLeaveBalancePageVm

@{
    ViewData["Title"] = "Leave balance";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <div class="toolbar-card mb-4">
            <div class="toolbar-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="bi bi-pie-chart"></i>Leave balance report</span>
                <div class="toolbar-actions d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-action-secondary">Back to leave requests</a>
                </div>
            </div>
        </div>

        <div class="filter-card mb-4">
            <div class="card-header">
                <span><i class="bi bi-funnel"></i>Filters</span>
            </div>
            <div class="card-body p-3 p-lg-4">
                <form asp-action="LeaveBalance" method="get" class="row g-3 align-items-end">
                    <div class="col-12 col-md">
                        <label class="form-label" for="year">Year</label>
                        <select name="year" id="year" class="form-select" required>
                            @foreach (var y in Model.YearChoices)
                            {
                                var ySel = string.Equals(y, Model.SelectedYear, StringComparison.OrdinalIgnoreCase);
                                if (ySel)
                                {
                                    <option value="@y" selected>@y</option>
                                }
                                else
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md">
                        <label class="form-label" for="department">Department</label>
                        <select name="department" id="department" class="form-select">
                            @foreach (var d in Model.DepartmentChoices)
                            {
                                var dSel = string.Equals(d.Value, Model.SelectedDepartment, StringComparison.OrdinalIgnoreCase);
                                if (dSel)
                                {
                                    <option value="@d.Value" selected>@d.Label</option>
                                }
                                else
                                {
                                    <option value="@d.Value">@d.Label</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto d-flex align-items-end">
                        <button type="submit" class="btn btn-action-primary w-100">
                            <i class="bi bi-funnel-fill me-1"></i>Apply
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="grid-card mb-4">
            <div class="card-header">
                <span><i class="bi bi-table"></i>Leave balances</span>
            </div>
            <div class="card-body">
                <p class="text-muted small px-3 pt-3 mb-0">
                    For each leave type, <strong>balance</strong> = <strong>available</strong> quota for the year minus leave days from <strong>approved or applied</strong> requests that fall in that year.
                </p>

                @if (Model.Rows.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No rows to show</h5>
                        <p class="mb-0">Check leave quota for the selected year, or choose another department.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Name</th>
                                    <th>Leave type</th>
                                    <th class="text-end">Available leave</th>
                                    <th class="text-end">Availed leave</th>
                                    <th class="text-end">Balance leave</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Rows)
                                {
                                    <tr>
                                        <td>@row.EmployeeCode</td>
                                        <td>@(row.EmployeeName ?? "—")</td>
                                        <td>@row.LeaveTypeName</td>
                                        <td class="text-end">@row.AvailableLeaves</td>
                                        <td class="text-end">@row.AvailedLeaves.ToString("0.##")</td>
                                        <td class="text-end">@row.BalanceLeaves.ToString("0.##")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
