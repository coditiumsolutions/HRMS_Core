@model HRMBT.Web.Models.LeaveRequest
@{
    var emp = ViewBag.Employee as HRMBT.Web.Models.Employee;
    var open = HRMBT.Web.Services.LeaveRulesService.IsOpen(Model.Status);
    ViewData["Title"] = "Leave request";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-3">
    <div class="container-fluid px-0">
        <partial name="_Alerts" />
        <div class="grid-card mb-3">
            <div class="card-header"><span><i class="bi bi-file-earmark-text"></i>Leave request #@Model.Id</span></div>
            <div class="card-body grid-form">
            <dl class="row mb-0">
                <dt class="col-sm-4">Employee</dt>
                <dd class="col-sm-8">
                    @if (emp != null)
                    {
                        <a asp-controller="Employee" asp-action="Details" asp-route-id="@emp.uid">@emp.EmployeeName</a>
                        <span class="text-muted small">· ID @emp.EmployeeID</span>
                    }
                    else { <span class="text-muted">Unknown employee</span> }
                </dd>
                <dt class="col-sm-4">Leave type</dt>
                <dd class="col-sm-8">@Model.LeaveType</dd>
                <dt class="col-sm-4">Dates</dt>
                <dd class="col-sm-8">@Fmt.ShortDate(Model.FromDate) to @Fmt.ShortDate(Model.ToDate)</dd>
                <dt class="col-sm-4">Days charged</dt>
                <dd class="col-sm-8">@Fmt.Days(Model.TotalDays) <span class="text-muted small">(@((Model.ToDate.Date - Model.FromDate.Date).Days + 1) calendar day(s))</span></dd>
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@(Model.Status ?? "—")</dd>
                <dt class="col-sm-4">Approved</dt>
                <dd class="col-sm-8">@(Model.ApprovedAt == null ? "—" : Fmt.DateAndTime(Model.ApprovedAt) + (ViewBag.Approver is string by ? " by " + by : ""))</dd>
                <dt class="col-sm-4">Entered</dt>
                <dd class="col-sm-8">@Fmt.DateAndTime(Model.AppliedAt)@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "" : " by " + Model.CreatedBy)</dd>
            </dl>
            </div>
        </div>
        <div class="action-bar">
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-action-outline me-auto">Back to list</a>
                @if (emp != null)
                {
                    <a asp-controller="EmployeeSchedule" asp-action="Month" asp-route-id="@emp.uid" asp-route-month="@Model.FromDate.ToString("yyyy-MM")" class="btn btn-action-secondary">Month view</a>
                }
                @if (open)
                {
                    <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-action-danger">Cancel request</a>
                }
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-action-primary">Edit</a>
            </div>
        </div>
    </div>
</div>
