@model IEnumerable<HRMBT.Web.Models.LeaveQuota>

@{
    ViewData["Title"] = "Leaves quota";
    var editBaseUrl = Url.Action("EditLeaveQuota", "LMS");
    var deleteBaseUrl = Url.Action("DeleteLeaveQuota", "LMS");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-3 px-lg-4">

        <div class="toolbar-card mb-4">
            <div class="toolbar-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="bi bi-journal-bookmark"></i>Leaves quota</span>
                <div class="toolbar-actions d-flex flex-wrap gap-2">
                    <a asp-action="CreateLeaveQuota" class="btn btn-action-primary">
                        <i class="bi bi-plus-circle me-1"></i>Add quota
                    </a>
                    <a asp-action="Index" class="btn btn-action-secondary">Back to leave requests</a>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="grid-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Leave quotas</span>
                @if (Model != null && Model.Any())
                {
                    <div class="grid-selection-actions">
                        <a href="#" id="btnEditSelected" class="btn btn-sm btn-grid-edit disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a href="#" id="btnDeleteSelected" class="btn btn-sm btn-grid-delete disabled" aria-disabled="true" tabindex="-1"><i class="bi bi-trash me-1"></i>Delete</a>
                    </div>
                }
            </div>
            <div class="card-body">
                <p class="text-muted small px-3 pt-3 mb-0">
                    Yearly leave entitlements per type (<strong>dbo.LeaveQuota</strong>). One row per leave type per year.
                </p>
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="leaveQuotaGrid"
                               data-edit-base="@editBaseUrl"
                               data-delete-base="@deleteBaseUrl"
                               data-radio-class="hrms-row-select">
                            <thead>
                                <tr>
                                    <th class="col-select" scope="col"><span class="visually-hidden">Select</span></th>
                                    <th>@Html.DisplayNameFor(m => m.First().UID)</th>
                                    <th>@Html.DisplayNameFor(m => m.First().LeaveTypeName)</th>
                                    <th class="text-end">@Html.DisplayNameFor(m => m.First().TotalLeaves)</th>
                                    <th>@Html.DisplayNameFor(m => m.First().Year)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model)
                                {
                                    <tr data-record-id="@row.UID" title="Double-click to open">
                                        <td class="col-select">
                                            <input type="radio" class="form-check-input hrms-row-select" name="selectedLeaveQuota" value="@row.UID" aria-label="Select quota @row.LeaveTypeName" />
                                        </td>
                                        <td>@row.UID</td>
                                        <td>@row.LeaveTypeName</td>
                                        <td class="text-end">@row.TotalLeaves</td>
                                        <td>@row.Year</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No leave quota records found</h5>
                        <p class="mb-3">Add the first quota to get started.</p>
                        <a asp-action="CreateLeaveQuota" class="btn btn-action-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add quota
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
