@model IEnumerable<HRMBT.Web.Models.LeaveQuota>

@{
    ViewData["Title"] = "Leaves quota";
    var editBaseUrl = Url.Action("EditLeaveQuota", "LMS", new { id = "__id__" });
    var copyFrom = Model.Select(x => int.TryParse(x.Year, out var y) ? y : 0).Where(y => y > 0 && y <= DateTime.Today.Year).DefaultIfEmpty(0).Max();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/employee-list.css" asp-append-version="true" />
}

<div class="employee-list-page py-4">
    <div class="container-fluid px-0">

        <partial name="_Alerts" />
        @if (copyFrom > 0 && !Model.Any(x => x.Year == (copyFrom + 1).ToString()))
        {
            <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
                <span>There are no quotas for @(copyFrom + 1) yet; balances for that year will show none.</span>
                <form asp-action="CopyLeaveQuotas" method="post" class="ms-auto m-0">
                    <input type="hidden" name="year" value="@copyFrom" />
                    <button type="submit" class="btn btn-sm btn-action-primary">Copy @copyFrom to @(copyFrom + 1)</button>
                </form>
            </div>
        }

        <div class="grid-card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <span><i class="bi bi-table"></i>Leave quotas</span>
                <a class="btn btn-sm btn-grid-edit" asp-action="CreateLeaveQuota"><i class="bi bi-plus-lg me-1"></i>Add quota</a>
            </div>
            <div class="card-body">
                <p class="grid-note">
                    Yearly leave entitlement per leave type, the same for everyone. Give one person more or fewer days from their leave balance tab.
                </p>
                @if (Model != null && Model.Any())
                {
                    <div class="table-wrap table-responsive">
                        <table class="employee-grid hrms-selectable-grid" id="leaveQuotaGrid"
                               data-edit-base="@editBaseUrl">
                            <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(m => m.First().LeaveTypeName)</th>
                                    <th class="text-end">@Html.DisplayNameFor(m => m.First().TotalLeaves)</th>
                                    <th>@Html.DisplayNameFor(m => m.First().Year)</th>
                                    <th class="col-actions text-center" data-align="none" scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model)
                                {
                                    <tr data-record-id="@row.UID" title="Double-click to open">
                                        <td>@row.LeaveTypeName</td>
                                        <td class="text-end">@Fmt.Days(row.TotalLeaves)</td>
                                        <td>@row.Year</td>
                                        <td class="col-actions">
                                            <a class="row-action row-action-edit" asp-controller="LMS" asp-action="EditLeaveQuota" asp-route-id="@row.UID" title="Edit leave quota" aria-label="Edit leave quota"><i class="bi bi-pencil-square"></i></a>
                                            <a class="row-action row-action-delete" asp-controller="LMS" asp-action="DeleteLeaveQuota" asp-route-id="@row.UID" title="Delete leave quota" aria-label="Delete leave quota"><i class="bi bi-trash3"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5 class="mb-1">No leave quota records found</h5>
                        <p class="mb-3">Add the first quota to get started.</p>
                        <a asp-action="CreateLeaveQuota" class="btn btn-action-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add quota
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_HrmsGridSelectionScript")
}
