{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedHosts": "*",
  "EmployeeDocuments": {
    "UploadRoot": "uploads/employees",
    "MaxFileSizeBytes": 10485760,
    "MaxFilesPerUpload": 10,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".png", ".jpg", ".jpeg" ]
  }
}
