# Copy to .env (git-ignored) and fill in. See the notes at the top of .env.
# The application does not read this file; it only keeps reference connection strings.
# Active settings live in src/HRMBT.Web/appsettings.Development.json and appsettings.Production.json.

# Old / alternative servers (reference only)
ConnectionStrings__DefaultConnection4="Server=OLD_SERVER_IP,50001;Database=HRMS;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
ConnectionStrings__DefaultConnection3="Server=localhost,50001;Database=HRMS;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=Mandatory;TrustServerCertificate=True;"
ConnectionStrings__DefaultConnection2="Server=INTERNAL_SERVER;Database=Payroll2;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
ConnectionStrings__BTDatabase="Server=INTERNAL_SERVER;Database=BT;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
